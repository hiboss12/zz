local function applyESP(plr)
    if plr == LocalPlayer then return end
    local char = plr.Character
    if not char then clearHighlights(plr) return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then clearHighlights(plr) return end
    local role = getMM2Role(plr)
    local show = role == "Murderer" or role == "Sheriff" or role == "Hero" or Settings.ESPNentral
    if Settings.ESPRoles and show then
        local color = ROLE_COLORS[role] or ROLE_COLORS.Innocent
        local h = ESP.highlights[plr]
        if not h or not h.Parent or h.Parent ~= char then
            if h and h.Parent then h:Destroy() end
            h = Instance.new("Highlight")
            h.FillColor = color
            h.FillTransparency = 0.2
            h.OutlineTransparency = 1
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Parent = char
            ESP.highlights[plr] = h
        else
            h.FillColor = color
        end
    elseif ESP.highlights[plr] then
        if ESP.highlights[plr].Parent then ESP.highlights[plr]:Destroy() end
        ESP.highlights[plr] = nil
    end
    if Settings.ESPNametag and show then
        local data = ESP.nametags[plr]
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and (not data or not data.bb or not data.bb.Parent or data.bb.Parent ~= hrp) then
            if data and data.bb and data.bb.Parent then data.bb:Destroy() end
            local bb = Instance.new("BillboardGui")
            bb.Size = UDim2.new(0, 150, 0, 34)
            bb.StudsOffset = Vector3.new(0, 3.5, 0)
            bb.AlwaysOnTop = true
            bb.Adornee = hrp
            bb.Parent = hrp
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 1, 1)
            lbl.BackgroundTransparency = 1
            lbl.TextSize = 13
            lbl.TextStrokeTransparency = 0.3
            lbl.Parent = bb
            ESP.nametags[plr] = { bb = bb, lbl = lbl }
        end
    elseif ESP.nametags[plr] then
        if ESP.nametags[plr].bb and ESP.nametags[plr].bb.Parent then ESP.nametags[plr].bb:Destroy() end
        ESP.nametags[plr] = nil
    end
end

