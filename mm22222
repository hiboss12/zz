local function trackConn(key, conn)
    if S.conns[key] then pcall(function() S.conns[key]:Disconnect() end) end
    S.conns[key] = conn
    return conn
end

local function dropConn(key)
    if S.conns[key] then
        pcall(function() S.conns[key]:Disconnect() end)
        S.conns[key] = nil
    end
end

