UserInputService.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local kc = input.KeyCode
    if not kc or kc == Enum.KeyCode.Unknown then return end

    if S.keybindListening then
        Settings.Keybind = kc.Name
        if S.keybindBox then
            S.keybindBox.Text = kc.Name
            pcall(function() S.keybindBox:ReleaseFocus() end)
        end
        S.keybindListening = false
        return
    end

    if S.afKeyListening then
        Settings.AutoFireKey = kc.Name
        if S.afKeyBox then
            S.afKeyBox.Text = kc.Name
            pcall(function() S.afKeyBox:ReleaseFocus() end)
        end
        S.afKeyListening = false
        return
    end

    if UserInputService:GetFocusedTextBox() then return end

    local afKey = Settings.AutoFireKey
    if afKey and afKey ~= "" then
        local ok, target = pcall(function() return Enum.KeyCode[afKey] end)
        if ok and target and kc == target then
            setAutoFire(not Settings.AutoFire)
            notify("Auto Fire " .. (Settings.AutoFire and "ON" or "OFF"))
            return
        end
    end

    local kb = Settings.Keybind
    if kb and kb ~= "" then
        local ok, target = pcall(function() return Enum.KeyCode[kb] end)
        if ok and target and kc == target then
            main.Visible = not main.Visible
            reopen.Visible = not main.Visible
        end
    end
end)

