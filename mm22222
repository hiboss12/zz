end

local function isGunTool(t)
    if not t or not t:IsA("Tool") then return false end
    local n = t.Name:lower()
    return n:find("gun", 1, true) or n:find("pistol", 1, true) or n:find("revolver", 1, true) or n:find("sheriff", 1, true)
end

local function findGunEquipped()
    local char = LocalPlayer.Character
    if not char then return nil end
    local d = char:FindFirstChild("Gun")
    if d and d:IsA("Tool") then return d end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") and isGunTool(t) then return t end
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        local eq = hum:FindFirstChildWhichIsA("Tool")
        if eq and isGunTool(eq) then return eq end
    end
    return nil
end

local function findGunInBackpack()
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return nil end
    local d = bp:FindFirstChild("Gun")
    if d and d:IsA("Tool") then return d end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") and isGunTool(t) then return t end
    end
    return nil
end

local function getEquippedGun()
    return findGunEquipped() or findGunInBackpack()
end

local function ensureGunReady()
    local eq = findGunEquipped()
    if eq and eq.Parent == LocalPlayer.Character then return eq end
    local inBag = findGunInBackpack()
    if not inBag then return nil end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    pcall(function() hum:EquipTool(inBag) end)
    local deadline = tick() + 0.5
    while tick() < deadline do
        local e = findGunEquipped()
        if e and e.Parent == char then return e end
        task.wait(0.02)
    end
    return nil
end

local function findGunDrop()
    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("gundrop") then return obj end
        if obj:IsA("Model") then
            local f = obj:FindFirstChild("GunDrop", true)
            if f and f:IsA("BasePart") then return f end
        end
    end
    local gd = workspace:FindFirstChild("GunDrop", true)
    if gd and gd:IsA("BasePart") then return gd end
    return nil
end

local function hasTool(parent, name)
    if not parent then return false end
    for _, c in ipairs(parent:GetChildren()) do
        if c:IsA("Tool") then
            local n = c.Name:lower()
            if n == name:lower() or n:find(name:lower(), 1, true) then return true end
        end
    end
    return false
end

local function getRoleFromCache(plr)
    local info = S.roleCache[plr.Name]
    return info and info.Role or nil
end

local function getMM2Role(plr)
    if plr == LocalPlayer then return "Innocent" end
    local cached = getRoleFromCache(plr)
    if cached == "Murderer" or cached == "Sheriff" or cached == "Hero" then return cached end
    local char = plr.Character
    local bp = plr:FindFirstChildOfClass("Backpack")
    if hasTool(char, "Knife") or hasTool(bp, "Knife") then return "Murderer" end
    if hasTool(char, "Gun") or hasTool(bp, "Gun") then return "Sheriff" end
    return "Innocent"
end

local function isPlrMurderer(plr)
    if not plr or plr == LocalPlayer or not plr.Parent then return false end
    if getRoleFromCache(plr) == "Murderer" then return true end
    local char = plr.Character
    local bp = plr:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) or false
end

local function isLocalMurderer()
    if getRoleFromCache(LocalPlayer) == "Murderer" then return true end
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    return (char and char:FindFirstChild("Knife")) or (bp and bp:FindFirstChild("Knife")) or false
end

local function isLocalSheriffOrHero()
    local c = getRoleFromCache(LocalPlayer)
    if c == "Sheriff" or c == "Hero" then return true end
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    return hasTool(char, "Gun") or hasTool(bp, "Gun")
end

local function isTargetSafe(plr)
    if not plr or plr == LocalPlayer or not plr.Character then return false end
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    return isPlrMurderer(plr)
end

local function getMurderer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and getRoleFromCache(plr) == "Murderer" then return plr end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isPlrMurderer(plr) then return plr end
    end
    return nil
end

local function getSheriff()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and getRoleFromCache(plr) == "Sheriff" then return plr end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local bp = plr:FindFirstChild("Backpack")
            if (char and char:FindFirstChild("Gun")) or (bp and bp:FindFirstChild("Gun")) then return plr end
        end
    end
