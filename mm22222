local function ensureFolder()
    if type(makefolder) == "function" then
        local ok, exists = pcall(function() return isfolder(CONFIG_FOLDER) end)
        if not ok or not exists then pcall(makefolder, CONFIG_FOLDER) end
    end
end

local function listConfigs()
    ensureFolder()
    local out = {}
    if type(listfiles) ~= "function" then return out end
    local ok, files = pcall(listfiles, CONFIG_FOLDER)
    if not ok or not files then return out end
    for _, f in ipairs(files) do
        local name = f:match("([^/\\]+)%.json$")
        if name then table.insert(out, name) end
    end
    table.sort(out)
    return out
end

local function configPath(name)
    return CONFIG_FOLDER .. "/" .. name .. ".json"
end

local function saveConfig(name)
    if type(writefile) ~= "function" then return false end
    ensureFolder()
    local data = {}
    for k, v in pairs(Settings) do
        if type(v) ~= "function" and type(v) ~= "table" then data[k] = v end
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or not encoded then return false end
    return pcall(writefile, configPath(name), encoded)
end

local function applyConfig(data)
    for k, v in pairs(data) do
        if Settings[k] ~= nil then
            local c = S.controls[k]
            if c then
                pcall(c.set, v)
            else
                Settings[k] = v
            end
        end
    end
end

local function loadConfig(name)
    if type(readfile) ~= "function" then return false end
    local path = configPath(name)
    if type(isfile) == "function" then
        local ok, exists = pcall(isfile, path)
        if not ok or not exists then return false end
    end
    local ok, content = pcall(readfile, path)
    if not ok or not content then return false end
    local ok2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or type(data) ~= "table" then return false end
    applyConfig(data)
    return true
end

local function deleteConfig(name)
    if type(delfile) ~= "function" then return false end
    return pcall(delfile, configPath(name))
end

