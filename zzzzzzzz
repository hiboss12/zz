local function autoload()
    if not CONFIG.Config.Autoload or not filesAvailable() then
        return
    end

    local configs=getConfigs()

    if #configs==0 then
        return
    end

    local name=CONFIG.Config.Name

    if name=="" or not table.find(configs,name) then
        name=configs[1]
    end

    loadConfig(name)
end

