local function switch(name)
    currentTab=name

    CombatTab.BackgroundColor3=name=="Combat" and COLORS.On or COLORS.Input
    ChecksTab.BackgroundColor3=name=="Checks" and COLORS.On or COLORS.Input
    VisualTab.BackgroundColor3=name=="Visuals" and COLORS.On or COLORS.Input
    WhiteTab.BackgroundColor3=name=="Whitelist" and COLORS.On or COLORS.Input
    SettingsTab.BackgroundColor3=name=="Settings" and COLORS.On or COLORS.Input

    refresh()
end

