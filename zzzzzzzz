local function removeHighlight(plr)
    if _G.ZZZHighlights[plr] then
        _G.ZZZHighlights[plr]:Destroy()
        _G.ZZZHighlights[plr]=nil
    end
end

local function updateHighlight(plr)
    if plr==LP then
        return
    end

    local character=plr.Character

    if not character then
        removeHighlight(plr)
        return
    end

    if CONFIG.Visuals.TeamCheck and not isEnemy(plr) then
        removeHighlight(plr)
        return
    end

    local h=_G.ZZZHighlights[plr]

    if not h then
        h=Instance.new("Highlight")
        h.Name="ZZZHighlight"
        h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency=.75
        h.OutlineTransparency=0
        h.Parent=GUI
        _G.ZZZHighlights[plr]=h
    end

    h.Adornee=character

    if isWhitelisted(plr) then
        h.FillColor=COLORS.White
        h.OutlineColor=COLORS.White
    else
        h.FillColor=COLORS.Enemy
        h.OutlineColor=COLORS.Enemy
    end
end

local function updateHighlights()
    if not CONFIG.Visuals.HighlightAll then
        for plr in pairs(_G.ZZZHighlights) do
            removeHighlight(plr)
        end
        return
    end

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            updateHighlight(plr)
        end
    end
end

local function playerUnderCursor()
    local mouse=mousePosition()
    local result=nil
    local distance=35

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and plr.Character then
            local part=aimPart(plr.Character)

            if part then
                local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                if onScreen and pos.Z>0 then
                    local d=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude

                    if d<distance then
                        distance=d
                        result=plr
                    end
                end
            end
        end
    end

    return result
end

local function refreshConfigList()
    if not configList then
        return
    end

    for _,child in ipairs(configList:GetChildren()) do
        if not child:IsA("UIListLayout") then
            child:Destroy()
        end
    end

    local configs=getConfigs()

    if #configs==0 then
        local empty=Instance.new("TextLabel")
        empty.Size=UDim2.new(1,-4,0,35)
        empty.BackgroundTransparency=1
        empty.Font=Enum.Font.Gotham
        empty.Text="No saved configs"
        empty.TextColor3=COLORS.Muted
        empty.TextSize=11
        empty.TextXAlignment=Enum.TextXAlignment.Left
        empty.Parent=configList
        return
    end

    for _,name in ipairs(configs) do
        local row=Instance.new("Frame")
        row.Size=UDim2.new(1,-4,0,46)
        row.BackgroundColor3=name==CONFIG.Config.Name and COLORS.On or COLORS.Panel
        row.BorderSizePixel=0
        row.Parent=configList

        local rc=Instance.new("UICorner")
        rc.CornerRadius=UDim.new(0,8)
        rc.Parent=row

        local rs=Instance.new("UIStroke")
        rs.Color=COLORS.Border
        rs.Thickness=1
        rs.Parent=row

        local select=Instance.new("TextButton")
        select.Position=UDim2.fromOffset(8,5)
        select.Size=UDim2.new(1,-150,0,36)
        select.BackgroundTransparency=1
        select.BorderSizePixel=0
        select.Text=name
        select.TextColor3=name==CONFIG.Config.Name and COLORS.Text or COLORS.Muted
        select.TextSize=11
        select.Font=Enum.Font.GothamMedium
        select.TextXAlignment=Enum.TextXAlignment.Left
        select.Parent=row

        select.MouseButton1Click:Connect(function()
            CONFIG.Config.Name=name

            if configNameBox then
                configNameBox.Text=name
            end

            refreshConfigList()
        end)

        local load=Instance.new("TextButton")
        load.Position=UDim2.new(1,-136,0,6)
        load.Size=UDim2.fromOffset(60,34)
        load.BackgroundColor3=COLORS.Button
        load.BorderSizePixel=0
        load.Text="Load"
        load.TextColor3=COLORS.Text
        load.TextSize=10
        load.Font=Enum.Font.GothamMedium
        load.AutoButtonColor=false
        load.Parent=row

        local lc=Instance.new("UICorner")
        lc.CornerRadius=UDim.new(0,7)
        lc.Parent=load

        load.MouseButton1Click:Connect(function()
            local ok,msg=loadConfig(name)

            if configStatus then
                configStatus.Text=ok and "Loaded "..name or msg
            end

            if ok then
                target=nil
                refreshConfigList()
                updateHighlights()
                refresh()
            end
        end)

        local delete=Instance.new("TextButton")
        delete.Position=UDim2.new(1,-70,0,6)
        delete.Size=UDim2.fromOffset(60,34)
        delete.BackgroundColor3=COLORS.Button
        delete.BorderSizePixel=0
        delete.Text="Delete"
        delete.TextColor3=COLORS.Text
        delete.TextSize=10
        delete.Font=Enum.Font.GothamMedium
        delete.AutoButtonColor=false
        delete.Parent=row

        local dc=Instance.new("UICorner")
        dc.CornerRadius=UDim.new(0,7)
        dc.Parent=delete

        delete.MouseButton1Click:Connect(function()
            local ok,msg=deleteConfig(name)

            if configStatus then
                configStatus.Text=ok and "Deleted "..name or msg
            end

            refreshConfigList()
        end)
    end
end

