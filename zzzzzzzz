        if active and i.UserInputType==Enum.UserInputType.MouseMovement then
            update(i.Position.X)
        end
    end)

    connect(UIS.InputEnded,function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            active=false
        end
    end)

    val.Text=format(value)
