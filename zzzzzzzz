local function aimPart(character)
    if not character then return nil end

    if CONFIG.Camlock.AimPart=="Head" then
        return character:FindFirstChild("Head")
    end

    if CONFIG.Camlock.AimPart=="Torso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    end

    if CONFIG.Camlock.AimPart=="UpperTorso" then
        return character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    end

    if CONFIG.Camlock.AimPart=="LowerTorso" then
        return character:FindFirstChild("LowerTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
end

local function alive(character)
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    return humanoid and humanoid.Health>0
end

local function ko(character)
    if not character then return true end

    local humanoid=character:FindFirstChildOfClass("Humanoid")

    if humanoid and humanoid.Health<=0 then
        return true
    end

    for _,name in ipairs({"KO","K.O","Knocked"}) do
        local value=character:FindFirstChild(name)

        if value and value:IsA("BoolValue") and value.Value then
            return true
        end
    end

    return false
end

local function isWhitelisted(plr)
    return CONFIG.Whitelist.Users[tostring(plr.UserId)]==true
end

local function isEnemy(plr)
    if not plr or plr==LP then
        return false
    end

    if CONFIG.Whitelist.Enabled and not isWhitelisted(plr) then
        return false
    end

    if CONFIG.Checks.TeamCheck then
        if LP.Team and plr.Team then
            if LP.Team==plr.Team then
                return false
            end
        elseif LP.TeamColor==plr.TeamColor then
            return false
        end
    end

    return true
end

local function visible(part,character)
    if not part then
        return false
    end

    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={LP.Character,character}
    params.IgnoreWater=true

    local result=workspace:Raycast(
        Camera.CFrame.Position,
        part.Position-Camera.CFrame.Position,
        params
    )

    return result==nil
end

local function mousePosition()
    local p=UIS:GetMouseLocation()
    return Vector2.new(p.X,p.Y)
end

local function closest()
    local mouse=mousePosition()
    local found=nil
    local distance=math.huge

    for _,plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local character=plr.Character

            if character and alive(character) and (not CONFIG.Checks.KOCheck or not ko(character)) then
                local part=aimPart(character)

                if part then
                    local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                    if onScreen and pos.Z>0 then
                        local d=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude

                        if d<distance and (not CONFIG.Camlock.FOVCheck or d<=CONFIG.Camlock.FOV) then
                            local allowed=true

                            if CONFIG.Checks.WallCheck or CONFIG.Checks.VisibleCheck then
                                allowed=visible(part,character)
                            end

                            if allowed then
                                distance=d
                                found=plr
                            end
                        end
                    end
                end
            end
        end
    end

    return found
end

