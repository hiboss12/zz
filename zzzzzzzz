local FOLDER="ZZZConfigs"

local function clone(t)
    local r={}
    for k,v in pairs(t) do
        r[k]=type(v)=="table" and clone(v) or v
    end
    return r
end

local function merge(a,b)
    for k,v in pairs(a) do
        if type(v)=="table" and type(b[k])=="table" then
            merge(v,b[k])
        else
            b[k]=v
        end
    end
end

local function filesAvailable()
    return writefile and readfile and isfile and makefolder and isfolder and listfiles and delfile
end

local function ensureFolder()
    if filesAvailable() and not isfolder(FOLDER) then
        pcall(makefolder,FOLDER)
    end
end

local function configPath(name)
    return FOLDER.."/"..name..".json"
end

local function getConfigs()
    local result={}

    if not filesAvailable() then
        return result
    end

    ensureFolder()

    local ok,files=pcall(listfiles,FOLDER)

    if not ok or type(files)~="table" then
        return result
    end

    for _,path in ipairs(files) do
        local name=path:match("[^/\\]+$")
        if name then
            name=name:gsub("%.json$","")
            table.insert(result,name)
        end
    end

    table.sort(result)

    return result
end

local function saveConfig(name)
    if not filesAvailable() then
        return false,"File API unavailable"
    end

    if not name or name=="" then
        return false,"Enter a config name"
    end

    ensureFolder()

    local data=clone(CONFIG)
    data.Config.Name=name

    local ok,encoded=pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if not ok then
        return false,"Encode failed"
    end

    local success=pcall(writefile,configPath(name),encoded)

    if success then
        CONFIG.Config.Name=name
        return true,"Saved"
    end

    return false,"Save failed"
end

local function loadConfig(name)
    if not filesAvailable() then
        return false,"File API unavailable"
    end

    if not name or name=="" then
        return false,"Enter a config name"
    end

    ensureFolder()

    local path=configPath(name)

    if not isfile(path) then
        return false,"Config not found"
    end

    local ok,data=pcall(readfile,path)

    if not ok then
        return false,"Read failed"
    end

    local decodedOk,decoded=pcall(function()
        return HttpService:JSONDecode(data)
    end)

    if not decodedOk or type(decoded)~="table" then
        return false,"Invalid config"
    end

    merge(decoded,CONFIG)
    CONFIG.Config.Name=name

    return true,"Loaded"
end

local function deleteConfig(name)
    if not filesAvailable() then
        return false,"File API unavailable"
    end

    if not name or name=="" then
        return false,"Enter a config name"
    end

    local path=configPath(name)

    if not isfile(path) then
        return false,"Config not found"
    end

    local ok=pcall(delfile,path)

    if ok then
        if CONFIG.Config.Name==name then
            CONFIG.Config.Name=""
        end
        return true,"Deleted"
    end

    return false,"Delete failed"
end

local function unloadEverything()
    CONFIG.Camlock.Enabled=false

    if _G.ZZZConnections then
        for _,connection in ipairs(_G.ZZZConnections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
        _G.ZZZConnections={}
    end

    if _G.ZZZHighlights then
        for _,highlight in pairs(_G.ZZZHighlights) do
            pcall(function()
                highlight:Destroy()
            end)
        end
        _G.ZZZHighlights={}
    end

    if _G.ZZZGUI then
        pcall(function()
            _G.ZZZGUI:Destroy()
        end)
    end

    if _G.ZZZFOVGUI then
        pcall(function()
            _G.ZZZFOVGUI:Destroy()
        end)
    end

    _G.ZZZLoaded=false
end

if _G.ZZZLoaded then
    unloadEverything()
end

