local function findAimPart(character,name)
    local part=character:FindFirstChild(name)

    if part and part:IsA("BasePart") then
        return part
    end

    part=character:FindFirstChild(name,true)

    if part and part:IsA("BasePart") then
        return part
    end

    return nil
end

local function aimPart(character)
    if not character then
        return nil
    end

    local requested=CONFIG.Silent.AimPart

    if requested=="Random" then
        local cached=randomPartCache[character]

        if cached and cached.Parent==character and os.clock()-(randomPartTime[character] or 0)<.4 then
            return cached
        end

        local options={}

        for _,name in ipairs({"HeadHB","Head","UpperTorso","Torso","LowerTorso","HumanoidRootPart"}) do
            local part=findAimPart(character,name)

            if part then
                table.insert(options,part)
            end
        end

        local picked=character:FindFirstChild("HumanoidRootPart")

        if #options>0 then
            picked=options[math.random(1,#options)]
        end

        randomPartCache[character]=picked
        randomPartTime[character]=os.clock()

        return picked
    end

    local names={
        Head={"HeadHB","Head"},
        Torso={"Torso","UpperTorso","HumanoidRootPart"},
        UpperTorso={"UpperTorso","Torso","HumanoidRootPart"},
        LowerTorso={"LowerTorso","HumanoidRootPart","Torso"},
        Root={"HumanoidRootPart","Torso","UpperTorso"}
    }

    for _,name in ipairs(names[requested] or names.Head) do
        local part=findAimPart(character,name)

        if part then
            return part
        end
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function isWhitelisted(plr)
    return plr and CONFIG.Whitelist.Users[tostring(plr.UserId)]==true
end

local function teamValue(plr)
    if not plr then
        return nil
    end

    local team=plr.Team

    if team then
        return team
    end

    local attribute=plr:GetAttribute("Team")

    if attribute==nil then
        attribute=plr:GetAttribute("team")
    end

    if attribute==nil then
        attribute=plr:GetAttribute("TeamName")
    end

    if attribute==nil then
        attribute=plr:GetAttribute("TeamId")
    end

    if attribute~=nil then
        return attribute
    end

    local value=plr:FindFirstChild("Team") or plr:FindFirstChild("team")

    if value and value:IsA("StringValue") then
        return value.Value
    end

    if value and value:IsA("ObjectValue") and value.Value then
        return value.Value
    end

    local character=plr.Character

    if character then
        local charAttribute=character:GetAttribute("Team")

        if charAttribute~=nil then
            return charAttribute
        end

        local charValue=character:FindFirstChild("Team")

        if charValue and charValue:IsA("StringValue") then
            return charValue.Value
        end
    end

    return nil
end

local function sameTeam(plr)
    if not plr or plr==LP then
        return false
    end

    local mine=teamValue(LP)

    if mine==nil then
        return false
    end

    local theirs=teamValue(plr)

    if theirs==nil then
        return false
    end

    if typeof(mine)=="Instance" and typeof(theirs)=="Instance" then
        return mine==theirs
    end

    return tostring(mine)==tostring(theirs)
end

local function isEnemy(plr)
    if not plr or plr==LP then
        return false
    end

    if CONFIG.Whitelist.Enabled and not isWhitelisted(plr) then
        return false
    end

    if CONFIG.Checks.TeamCheck and sameTeam(plr) then
        return false
    end

    return true
end

local function visible(part,character)
    if not part or not character or not Camera then
        return false
    end

    local origin=Camera.CFrame.Position
    local direction=part.Position-origin

    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={LP.Character,character}
    params.IgnoreWater=true

    return workspace:Raycast(origin,direction,params)==nil
end

