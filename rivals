    local vp=cam.ViewportSize
    local maxScale=isMobile and 1.6 or 1
    local fit=math.min(maxScale,(vp.X-24)/UI.WinW,(vp.Y-24)/UI.WinH)
    local s=math.clamp(fit*(tonumber(CONFIG.GUI.Scale) or 1),.3,3)

    UI.RootScale.Scale=s
    UI.ShadowScale.Scale=s
    UI.MobileScale.Scale=s
end

