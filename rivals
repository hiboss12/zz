local function autoloadConfig()
    if not filesAvailable() then
        return false
    end

    for _,name in ipairs(getConfigs()) do
        local path=configPath(name)

        if isfile(path) then
            local ok,data=pcall(function()
                return HttpService:JSONDecode(readfile(path))
            end)

            if ok and type(data)=="table" and data.Config and data.Config.Autoload==true then
                if loadConfig(name) and applyLoadedConfig then
                    applyLoadedConfig()
                end

                return true
            end
        end
    end

    return false
end

