local function alive(character)
    if not character then
        return false
    end

    local hum=character:FindFirstChildOfClass("Humanoid")

    if not hum then
        return false
    end

    return hum.Health>0 and hum:GetState()~=Enum.HumanoidStateType.Dead
end

local function ko(character)
    if not character then
        return true
    end

    local hum=character:FindFirstChildOfClass("Humanoid")

    if not hum or hum.Health<=0 or hum:GetState()==Enum.HumanoidStateType.Dead then
        return true
    end

    local bodyEffects=character:FindFirstChild("BodyEffects")

    if bodyEffects then
        local knocked=bodyEffects:FindFirstChild("K.O") or bodyEffects:FindFirstChild("KO")
        local dead=bodyEffects:FindFirstChild("SDeath") or bodyEffects:FindFirstChild("Dead")

        if knocked and knocked:IsA("BoolValue") and knocked.Value then
            return true
        end

        if dead and dead:IsA("BoolValue") and dead.Value then
            return true
        end
    end

    local names={"KO","K.O","Knocked","Downed","IsKO","KnockedOut","BeingCarried"}

    for _,name in ipairs(names) do
        local value=character:FindFirstChild(name,true)

        if value and value:IsA("BoolValue") and value.Value then
            return true
        end

        if character:GetAttribute(name)==true then
            return true
        end
    end

    local player=Players:GetPlayerFromCharacter(character)

    if player then
        for _,name in ipairs(names) do
            if player:GetAttribute(name)==true then
                return true
            end
        end
    end

    return false
end

local function katanaName(text)
    if not text then
        return false
    end

    return string.find(string.lower(tostring(text)),"katana",1,true)~=nil
end

local function scanTools(character,match)
    if not character then
        return false
    end

    local humanoid=character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        local tool=humanoid:FindFirstChildOfClass("Tool")

        if tool and match(tool.Name) then
            return true
        end
    end

    for _,item in ipairs(character:GetDescendants()) do
        if item:IsA("Tool") or item:IsA("Model") or item:IsA("BasePart") then
            if match(item.Name) then
                return true
            end
        elseif item:IsA("StringValue") or item:IsA("ObjectValue") then
            local value=item:IsA("StringValue") and item.Value or (item.Value and item.Value.Name or "")

            if match(value) then
                return true
            end
        end
    end

    for name,value in pairs(character:GetAttributes()) do
        if type(value)=="string" and match(value) then
            return true
        end

        if match(name) and value==true then
            return true
        end
    end

    return false
end

local function hasKatana(character)
    return scanTools(character,katanaName)
end

local deathWatch={}

local function watchCharacter(plr,character)
    if deathWatch[plr] then
        for _,connection in ipairs(deathWatch[plr]) do
            connection:Disconnect()
        end
    end

    local list={}
    deathWatch[plr]=list

    local function releaseTarget()
        if target==plr then
            target=nil
            orbitTarget=nil
            camRun=false
        end
    end

    local function watchValue(value)
        if not value or not value:IsA("BoolValue") then
            return
        end

        if value.Value then
            releaseTarget()
        end

        table.insert(list,value:GetPropertyChangedSignal("Value"):Connect(function()
            if value.Value then
                releaseTarget()
            end
        end))
    end

    if not character then
        return
    end

    local hum=character:FindFirstChildOfClass("Humanoid")

    if hum then
        table.insert(list,hum.Died:Connect(releaseTarget))
        table.insert(list,hum:GetPropertyChangedSignal("Health"):Connect(function()
            if hum.Health<=0 then
                releaseTarget()
            end
        end))
    end

    local bodyEffects=character:FindFirstChild("BodyEffects")

    if bodyEffects then
        watchValue(bodyEffects:FindFirstChild("K.O") or bodyEffects:FindFirstChild("KO"))
        watchValue(bodyEffects:FindFirstChild("SDeath") or bodyEffects:FindFirstChild("Dead"))
        table.insert(list,bodyEffects.ChildAdded:Connect(function(child)
            if child.Name=="K.O" or child.Name=="KO" or child.Name=="SDeath" or child.Name=="Dead" then
                watchValue(child)
            end
        end))
    else
        table.insert(list,character.ChildAdded:Connect(function(child)
            if child.Name=="BodyEffects" then
                watchValue(child:FindFirstChild("K.O") or child:FindFirstChild("KO"))
                watchValue(child:FindFirstChild("SDeath") or child:FindFirstChild("Dead"))
                table.insert(list,child.ChildAdded:Connect(function(value)
                    if value.Name=="K.O" or value.Name=="KO" or value.Name=="SDeath" or value.Name=="Dead" then
                        watchValue(value)
                    end
                end))
            end
        end))
    end
end

