    })

    local track=create("Frame",{
        Position=UDim2.fromOffset(0,32),
        Size=UDim2.new(1,0,0,6),
        BackgroundColor3=COLORS.Track,
        BackgroundTransparency=.15,
        BorderSizePixel=0,
