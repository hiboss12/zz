local function screenCenter()
    if not Camera then
        return Vector2.zero
    end

    return Camera.ViewportSize/2
end

local function closest()
    if not Camera then
        return nil,math.huge
    end

    local center=screenCenter()
    local best=nil
    local bestDistance=math.huge

    for _,plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local character=plr.Character

            if character and alive(character) and (not CONFIG.Checks.KOCheck or not ko(character)) then
                local part=aimPart(character)

                if part then
                    local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                    if onScreen and pos.Z>0 then
                        local distance=(Vector2.new(pos.X,pos.Y)-center).Magnitude

                        if (not CONFIG.Silent.FOVCheck or distance<=CONFIG.Silent.FOV) and distance<bestDistance then
                            local allowed=true

                            if CONFIG.Checks.WallCheck or CONFIG.Checks.VisibleCheck then
                                allowed=visible(part,character)
                            end

                            if allowed then
                                best=plr
                                bestDistance=distance
                            end
                        end
                    end
                end
            end
        end
    end

    return best,bestDistance
end

local function playerUnderCursor()
    if not Camera then
        return nil
    end

    local mouse=mousePosition()
    local closestPlayer=nil
    local closestDistance=90

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            local character=plr.Character

            if character then
                for _,partName in ipairs({"Head","HumanoidRootPart","UpperTorso","Torso","LowerTorso"}) do
                    local part=character:FindFirstChild(partName)

                    if part and part:IsA("BasePart") then
                        local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                        if onScreen and pos.Z>0 then
                            local distance=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude

                            if distance<closestDistance then
                                closestPlayer=plr
                                closestDistance=distance
                            end
                        end
                    end
                end
            end
        end
    end

    return closestPlayer
end

local function silentActive()
    return CONFIG.Silent.Enabled and silentReady
end

local function entityList(ignoreTeam)
    local list={}
    local tags=CS:GetTagged("Entity")

    local function allow(plr)
        if not plr or plr==LP then
            return false
        end

        if CONFIG.Whitelist.Enabled and not isWhitelisted(plr) then
            return false
        end

        if not ignoreTeam and CONFIG.Checks.TeamCheck and sameTeam(plr) then
            return false
        end

        return true
    end

    if #tags>0 then
        for _,entity in ipairs(tags) do
            local plr=Players:GetPlayerFromCharacter(entity)

            if allow(plr) then
                table.insert(list,{plr=plr,character=entity})
            end
        end
    else
        for _,plr in ipairs(Players:GetPlayers()) do
            if allow(plr) and plr.Character then
                table.insert(list,{plr=plr,character=plr.Character})
            end
        end
    end

    return list
end

local function silentAimPart()
    if not Camera then
        return nil
    end

    local center=screenCenter()
    local list=entityList(false)

    if #list==0 then
        list=entityList(true)
    end

    local best=nil
    local bestDistance=math.huge

    for _,entry in ipairs(list) do
        local character=entry.character

        if character and character.Parent and alive(character) and (not CONFIG.Checks.KOCheck or not ko(character)) then
            local part=aimPart(character)

            if part and part.Parent then
                local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                if onScreen and pos.Z>0 then
                    local distance=(Vector2.new(pos.X,pos.Y)-center).Magnitude

                    if distance<bestDistance then
                        best=part
                        bestDistance=distance
                    end
                end
            end
        end
    end

    return best
end

local function leadPoint(part)
    local pos=part.Position
    local lead=tonumber(CONFIG.Silent.AimLead) or 0

    if lead<=0 then
        return pos
    end

    local vel=part.AssemblyLinearVelocity

    if vel.Magnitude<2 then
        return pos
    end

    local ok,ping=pcall(function()
        return LP:GetNetworkPing()
    end)

    local t=math.clamp((ok and ping or .08)*.5,0,.15)*lead
    local offset=vel*t

    if offset.Magnitude>12 then
        offset=offset.Unit*12
    end

    return pos+offset
end

local function acquireShot(origin)
    local now=os.clock()

    if shotPart and shotPart.Parent and shotPos and shotOrigin and now-shotTime<.12 and (shotOrigin-origin).Magnitude<6 then
        shotPos=leadPoint(shotPart)
        shotTime=now
        return shotPart,shotPos
    end

    local part=silentAimPart()

    if not part then
        shotPart=nil
        shotPos=nil
        return nil,nil
    end

    shotPart=part
    shotPos=leadPoint(part)
    shotOrigin=origin
    shotTime=now

    return part,shotPos
end

local function silentCFD(origin,part,pos)
    local cf=part.CFrame
    local data={}

    data[utf8.char(1)]={
        [utf8.char(0)]=silentUtil:EncodeCFrame(CFrame.lookAt(origin,pos)),
        [utf8.char(1)]=silentUtil:EncodeCFrame(cf),
        [utf8.char(2)]=part,
        [utf8.char(3)]=silentUtil:EncodeCFrame(cf:ToObjectSpace(CFrame.new(pos)))
    }

    return data
end

local function setupSilent()
    if silentReady then
        return true
    end

    local ok=pcall(function()
        local reps=game:GetService("ReplicatedStorage")
        local U=require(reps.Modules.Utility)
        local EL=require(reps.Modules.EnumLibrary)
        local GU=require(reps.Modules.GameplayUtility)

        silentUtil=U
        silentEnum=EL
        silentGU=GU
        silentOriginalRaycast=GU.GetEntitiesFromRaycast

        GU.GetEntitiesFromRaycast=function(self,envID,params,origin,dir,maxDist,...)
            if silentActive() then
                local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local base=root and root.Position or origin
                local part,pos=acquireShot(base)

                if part and pos then
                    local delta=pos-base

                    if delta.Magnitude>.05 then
                        dir=delta.Unit
                        maxDist=math.max(maxDist,delta.Magnitude+10)
                    end
                end
            end

            return silentOriginalRaycast(self,envID,params,origin,dir,maxDist,...)
        end

        pcall(function()
            local gun=require(LP.PlayerScripts.Modules.ItemTypes.Gun)

            if gun and gun.IsFullyAiming then
                gun.IsFullyAiming=function() return true end
            end
        end)

        if type(hookfunction)=="function" and type(newcclosure)=="function" then
            local remote=reps.Remotes.Replication.Fighter.UseItem
            local original=remote.FireServer
            local startShooting=silentEnum:ToEnum("StartShooting")

            local hooked
            hooked=hookfunction(original,newcclosure(function(self,objID,enumVal,camdata,extra)
                if silentActive() and enumVal==startShooting then
                    local root=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

                    if root then
                        local part,pos=acquireShot(root.Position)

                        if part and pos then
                            camdata=silentCFD(root.Position,part,pos)
                        end
                    end
                end

                return hooked(self,objID,enumVal,camdata,extra)
            end))

            silentFireRemote=remote
            silentFireOriginal=original
        end

        silentReady=true
    end)

    return ok and silentReady
end

local function destroySilent()
    if silentGU and silentOriginalRaycast then
        pcall(function()
            silentGU.GetEntitiesFromRaycast=silentOriginalRaycast
        end)
    end

    if silentFireRemote and silentFireOriginal then
        pcall(function()
            silentFireRemote.FireServer=silentFireOriginal
        end)
    end

    silentReady=false
    shotPart=nil
    shotPos=nil
end

local function triggerTarget()
    if not Camera then
        return nil
    end

    local mouse=mousePosition()
    local best=nil
    local bestDistance=60
    local checks=CONFIG.Triggerbot.Checks

    for _,plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) and not (checks.Team and sameTeam(plr)) then
            local character=plr.Character

            if character and alive(character) then
                if not checks.KO or not ko(character) then
                    if not checks.Katana or not isRivals() or not hasKatana(character) then
                        if not checks.Forcefield or not character:FindFirstChildOfClass("ForceField") then
                            local part=aimPart(character)

                            if part then
                                local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                                if onScreen and pos.Z>0 then
                                    local distance=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude

                                    if distance<bestDistance then
                                        if not checks.Visible or visible(part,character) then
                                            best=plr
                                            bestDistance=distance
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

