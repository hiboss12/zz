local function buildPage(tab)
    local page=UI.Pages[tab]

    if page and page.Parent then
        for _,child in ipairs(page:GetChildren()) do
            if not child:IsA("UIListLayout") then
                child:Destroy()
            end
        end
    else
        page=create("Frame",{
            Name="Page_"..tab,
            Size=UDim2.new(1,0,0,0),
            AutomaticSize=Enum.AutomaticSize.Y,
            BackgroundTransparency=1,
            Parent=UI.Body
        })

        create("UIListLayout",{
            Padding=UDim.new(0,10),
            SortOrder=Enum.SortOrder.LayoutOrder,
            Parent=page
        })

        UI.Pages[tab]=page
    end

    currentPage=page
    currentCard=nil
    buildTabContent(tab)
    currentPage=nil
    currentCard=nil
end

function refresh()
    buildSubTabs()

    if not UI.Body or not UI.HeaderTitle or not UI.KeybindLabel then
        return
    end

    UI.HeaderTitle.Text=currentTab
    UI.HeaderSub.Text=TAB_SUBTITLES[currentTab] or ""
    UI.KeybindLabel.Text=CONFIG.GUI.HideKeybind

    local page=UI.Pages[currentTab]

    if not page or not page.Parent or dirtyPages[currentTab] then
        dirtyPages[currentTab]=false
        buildPage(currentTab)
    end

    for name,other in pairs(UI.Pages) do
        if other and other.Parent then
            other.Visible=name==currentTab
        end
    end

    applyFilter()
    updateNav()
end

connect(UIS.InputBegan,function(input)
    if input.UserInputType~=Enum.UserInputType.Keyboard then
        return
    end

    local key=input.KeyCode

    if key==Enum.KeyCode.Unknown then
        return
    end

    local name=key.Name

    if waitingTrigger then
        CONFIG.Triggerbot.Keybind=name
        waitingTrigger=false
        triggerHeld=false
        dirtyPages.Combat=true
        refresh()
        return
    end

    if waitingOrbit then
        CONFIG.Silent.OrbitKeybind=name
        waitingOrbit=false
        dirtyPages.Combat=true
        refresh()
        return
    end

    if waitingHide then
        CONFIG.GUI.HideKeybind=name
        waitingHide=false
        UI.Hidden=false
        applyVisibility()
        dirtyPages.Settings=true
        refresh()
        return
    end

    if waitingWhitelist then
        CONFIG.Whitelist.Keybind=name
        waitingWhitelist=false
        dirtyPages.Whitelist=true
        refresh()
        return
    end

    if waitingNoclip then
        CONFIG.Games.NoclipKeybind=name
        waitingNoclip=false
        dirtyPages.Games=true
        refresh()
        return
    end

    if waitingCFrame then
        CONFIG.Games.CFrameKeybind=name
        waitingCFrame=false
        dirtyPages.Games=true
        refresh()
        return
    end

    if name==CONFIG.GUI.HideKeybind then
        UI.Hidden=not UI.Hidden
        applyVisibility()
        return
    end

    if name==CONFIG.Triggerbot.Keybind then
        if not CONFIG.Triggerbot.Enabled then
            return
        end

        triggerTimer=0

        if CONFIG.Triggerbot.Mode=="Toggle" then
            triggerHeld=not triggerHeld
        else
            triggerHeld=true
        end

        return
    end

    if name==CONFIG.Games.NoclipKeybind then
        if not CONFIG.Games.Noclip then
            return
        end

        setNoclip(not noclipRun)
        return
    end

    if name==CONFIG.Games.CFrameKeybind then
        if not CONFIG.Games.CFrameSpeedEnabled then
            return
        end

        cframeRun=not cframeRun
        return
    end

    if name==CONFIG.Whitelist.Keybind then
        local plr=playerUnderCursor()

        if plr then
            local id=tostring(plr.UserId)

            if CONFIG.Whitelist.Users[id] then
                CONFIG.Whitelist.Users[id]=nil
            else
                CONFIG.Whitelist.Users[id]=true
            end

            updateHighlight(plr)
            dirtyPages.Whitelist=true

            if currentTab=="Whitelist" then
                refresh()
            end
        end

        return
    end

    if name==CONFIG.Silent.OrbitKeybind then
        if not CONFIG.Silent.Orbit then
            return
        end

        orbitRun=not orbitRun
        orbitTarget=nil

        if orbitRun then
            if not CONFIG.Silent.Enabled then
                CONFIG.Silent.Enabled=true
                task.spawn(setupSilent)
            end

            camRun=true
            target=closest()
        end

        return
    end
end)

