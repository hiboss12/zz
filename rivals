local highlightNext={}
local highlightFolder=nil

local function ensureHighlightFolder()
    if highlightFolder and highlightFolder.Parent then
        return highlightFolder
    end

    local existing=workspace:FindFirstChild("ZZZHighlights")

    if existing then
        highlightFolder=existing
        return highlightFolder
    end

    highlightFolder=create("Folder",{
        Name="ZZZHighlights",
        Parent=workspace
    })

    return highlightFolder
end

local function removeHighlight(plr)
    local h=Highlights[plr]

    if h then
        pcall(function()
            h.Adornee=nil
            h:Destroy()
        end)

        Highlights[plr]=nil
    end

    highlightNext[plr]=nil
end

local function highlightColor(plr)
    if isWhitelisted(plr) then
        return COLORS.Whitelist
    end

    return COLORS.Accent
end

local function shouldHighlight(plr)
    if not CONFIG.Visuals.HighlightAll then
        return false
    end

    if not plr or plr==LP then
        return false
    end

    if not plr.Parent then
        return false
    end

    if CONFIG.Visuals.TeamCheck and sameTeam(plr) then
        return false
    end

    return plr.Character~=nil
end

local function updateHighlight(plr)
    if not shouldHighlight(plr) then
        removeHighlight(plr)
        return
    end

    local character=plr.Character

    if not character or not character.Parent then
        removeHighlight(plr)
        return
    end

    local h=Highlights[plr]
    local now=os.clock()

    local broken=h==nil
        or h.Parent==nil
        or h.Adornee~=character
        or not character:FindFirstChild("HumanoidRootPart")

    if broken then
        removeHighlight(plr)

        h=create("Highlight",{
            Name="ZZZHighlight",
            DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
            FillTransparency=.6,
            OutlineTransparency=0,
            Parent=ensureHighlightFolder()
        })

        Highlights[plr]=h
        highlightNext[plr]=now+math.random(80,180)/100
    elseif now>=(highlightNext[plr] or 0) then
        highlightNext[plr]=now+math.random(80,180)/100
        h.Adornee=nil
        h.Adornee=character
    end

    local color=highlightColor(plr)

    h.Adornee=character
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency=.6
    h.OutlineTransparency=0
    h.FillColor=color
    h.OutlineColor=color
end

local function updateAllHighlights()
    if not CONFIG.Visuals.HighlightAll then
        for plr in pairs(Highlights) do
            removeHighlight(plr)
        end

        table.clear(highlightNext)

        if highlightFolder then
            pcall(function()
                highlightFolder:Destroy()
            end)

            highlightFolder=nil
        end

        return
    end

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            updateHighlight(plr)
        end
    end
end

local function refreshHighlights()
    if not CONFIG.Visuals.HighlightAll then
        return
    end

    ensureHighlightFolder()

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            updateHighlight(plr)
        end
    end

    for plr in pairs(Highlights) do
        if not plr.Parent then
            removeHighlight(plr)
        end
    end
end

local function clearHighlights()
    for plr in pairs(Highlights) do
        removeHighlight(plr)
    end

    table.clear(highlightNext)

    if highlightFolder then
        pcall(function()
            highlightFolder:Destroy()
        end)

        highlightFolder=nil
    end
end

