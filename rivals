function rivalsSnap(part)
    if type(mousemoverel)~="function" or not Camera then
        return
    end

    local screen,onScreen=Camera:WorldToViewportPoint(part.Position)

    if not onScreen then
        return
    end

    local mouse=mousePosition()

    aimTarget=part.Position
    aimRivals=true

    pcall(function()
        mousemoverel(screen.X-mouse.X,screen.Y-mouse.Y)
    end)
end

connect(RS.RenderStepped,function(dt)
    pcall(function()
        camActive=false
        aimRivals=false
        updateFOV()

        local cam=workspace.CurrentCamera

        if cam then
            Camera=cam
        end

        serverInfoTimer+=dt

        if serverInfoTimer>=0.5 then
            serverInfoTimer=0

            if serverInfoLabel and serverInfoLabel.Parent then
                updateServerInfo()
            end
        end

        highlightTimer+=dt

        if CONFIG.Visuals.HighlightAll and highlightTimer>=0.2 then
            highlightTimer=0
            refreshHighlights()
        end

        if CONFIG.Games.CFrameSpeedEnabled and cframeRun and CONFIG.Games.CFrameSpeed>0 and not orbitActive then
            local character=LP.Character
            local humanoid=character and character:FindFirstChildOfClass("Humanoid")
            local root=character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and root and humanoid.Health>0 then
                local direction=humanoid.MoveDirection

                if direction.Magnitude>0 then
                    root.CFrame=root.CFrame+direction*(CONFIG.Games.CFrameSpeed*dt*60)
                end
            end
        end

        orbitActive=false

        gameFeatureTimer+=dt

        if gameFeatureTimer>=1 then
            gameFeatureTimer=0

            if CONFIG.Games.ArsenalHitbox then
                setArsenalHitbox(true)
            end
        end

        if not CONFIG.Silent.Enabled then
            target=nil
            orbitTarget=nil
            orbitPart=nil
            aimTarget=nil
            return
        end

        camRun=true

        if not Camera then
            return
        end

        local picked=closest()

        if not picked then
            target=nil
            orbitTarget=nil
            orbitPart=nil
            targetDistance=math.huge
            return
        end

        target=picked

        local character=target.Character
        local part=character and aimPart(character)

        if not part then
            return
        end

        if CONFIG.Silent.Orbit and orbitRun then
            orbitPart=part
            orbitActive=true
            return
        end

        orbitPart=nil
        orbitTarget=nil

        if silentReady then
            aimTarget=nil
            return
        end

        if isRivals() then
            rivalsSnap(part)
            return
        end

        aimTarget=part.Position
        camActive=true
        holdLock()
    end)
end)

