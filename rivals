local function clearAutoloadFlags(exceptName)
    if not filesAvailable() then
        return
    end

    for _,name in ipairs(getConfigs()) do
        if name~=exceptName then
            local path=configPath(name)

            if isfile(path) then
                local ok,data=pcall(function()
                    return HttpService:JSONDecode(readfile(path))
                end)

                if ok and type(data)=="table" and data.Config and data.Config.Autoload==true then
                    data.Config.Autoload=false

                    pcall(function()
                        writefile(path,HttpService:JSONEncode(data))
                    end)
                end
            end
        end
    end
end

local function resetAutoload()
    CONFIG.Config.Autoload=false

    if not filesAvailable() then
        return
    end

    for _,name in ipairs(getConfigs()) do
        local path=configPath(name)

        if isfile(path) then
            local ok,data=pcall(function()
                return HttpService:JSONDecode(readfile(path))
            end)

            if ok and type(data)=="table" then
                if data.Config then
                    data.Config.Autoload=false
                end

                pcall(function()
                    writefile(path,HttpService:JSONEncode(data))
                end)
            end
        end
    end
end

