local function buildSubTabs()
    if not UI.SubTabs then
        return
    end

    local list=SUBTABS[currentTab] or {"Main"}

    if not table.find(list,currentSubTab) then
        currentSubTab=list[1]
    end

    local same=subTabCache.parent==UI.SubTabs and subTabCache.tab==currentTab and #subTabCache.buttons==#list

    if not same then
        for _,entry in ipairs(subTabCache.buttons) do
            if entry.button and entry.button.Parent then
                entry.button:Destroy()
            end
        end

        subTabCache={parent=UI.SubTabs,tab=currentTab,buttons={}}

        for index,name in ipairs(list) do
            local b=create("TextButton",{
                Size=UDim2.fromOffset(#name*7+32,30),
