        Size=UDim2.fromOffset(14,14),
        BackgroundColor3=COLORS.Card,
        BorderSizePixel=0,
        Parent=track
    })

    corner(knob,7)
    stroke(knob,COLORS.Accent,1,.35)

    local dragSlider=false

    local function setFromX(x)
        local width=track.AbsoluteSize.X

        if width<=0 then
            return
        end

        local pct=math.clamp((x-track.AbsolutePosition.X)/width,0,1)
        local newValue=min+(max-min)*pct

        if max-min<=1 then
            newValue=math.floor(newValue*100)/100
        else
            newValue=math.floor(newValue+.5)
        end

        fill.Size=UDim2.new(pct,0,1,0)
        knob.Position=UDim2.new(pct,0,.5,0)
        valueLabel.Text=tostring(newValue)
        callback(newValue)
    end

    gconnect(track.InputBegan,function(input)
        if isPress(input) then
            dragSlider=true
            setFromX(input.Position.X)
        end
    end)

    gconnect(UIS.InputChanged,function(input)
        if dragSlider and isMove(input) then
            setFromX(input.Position.X)
        end
    end)

    gconnect(UIS.InputEnded,function(input)
        if isPress(input) then
            dragSlider=false
        end
    end)

    return r
end

