local function spectatePlayer(plr)
    if not plr or plr==LP then
        return false
    end

    local character=plr.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid or humanoid.Health<=0 then
        return false
    end

    Camera=workspace.CurrentCamera
    if not Camera then
        return false
    end

    selectedSpectateTarget=plr
    isSpectating=true
    CONFIG.Camlock.Enabled=false
    target=nil
    Camera.CameraType=Enum.CameraType.Custom
    Camera.CameraSubject=humanoid
    return true
end

local function unspectatePlayer()
    isSpectating=false
    selectedSpectateTarget=nil
    Camera=workspace.CurrentCamera

    local character=LP.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")

    if Camera and humanoid then
        Camera.CameraType=Enum.CameraType.Custom
        Camera.CameraSubject=humanoid
    end
end

local function teleportToSpectateTarget()
    local plr=selectedSpectateTarget
    local character=plr and plr.Character
    local targetRoot=character and character:FindFirstChild("HumanoidRootPart")
    local ownCharacter=LP.Character
    local ownRoot=ownCharacter and ownCharacter:FindFirstChild("HumanoidRootPart")

    if targetRoot and ownRoot then
        ownRoot.CFrame=targetRoot.CFrame*CFrame.new(0,3,0)
    end
end

