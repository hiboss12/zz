local function slider(name,value,min,max,callback)
    local holder=Instance.new("Frame")
    holder.Size=UDim2.new(1,0,0,55)
    holder.BackgroundTransparency=1
    holder.Parent=Content

    local label=Instance.new("TextLabel")
    label.BackgroundTransparency=1
    label.Size=UDim2.new(1,0,0,22)
    label.Font=Enum.Font.Gotham
    label.TextColor3=Color3.fromRGB(239,240,248)
    label.TextSize=13
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.Text=name.."  "..tostring(value)
    label.Parent=holder

    local bar=Instance.new("Frame")
    bar.Position=UDim2.fromOffset(0,30)
    bar.Size=UDim2.new(1,0,0,6)
    bar.BackgroundColor3=COLORS.Input
    bar.BorderSizePixel=0
    bar.Parent=holder

    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(1,0)
    corner.Parent=bar

    local fill=Instance.new("Frame")
    fill.Size=UDim2.new((value-min)/(max-min),0,1,0)
    fill.BackgroundColor3=COLORS.On
    fill.BorderSizePixel=0
    fill.Parent=bar

    local fillCorner=Instance.new("UICorner")
    fillCorner.CornerRadius=UDim.new(1,0)
    fillCorner.Parent=fill

    local dragging=false

    local function setFromX(x)
        local pct=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local newValue=min+(max-min)*pct

        if max-min<=1 then
            newValue=math.floor(newValue*100)/100
        else
            newValue=math.floor(newValue+.5)
        end

        fill.Size=UDim2.new(pct,0,1,0)
        label.Text=name.."  "..tostring(newValue)
        callback(newValue)
    end

    connect(bar.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputChanged,function(input)
        if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputEnded,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=false
        end
    end)

    return holder
end

local function toggle(name,value,callback)
