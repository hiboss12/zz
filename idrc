local dragging=false
local dragStart
local startPos

connect(Top.InputBegan,function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=true
        dragStart=input.Position
        startPos=Main.Position
    end
end)

connect(UIS.InputChanged,function(input)
    if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
        local delta=input.Position-dragStart

        Main.Position=UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset+delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset+delta.Y
        )
    end
end)

connect(UIS.InputEnded,function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        dragging=false
    end
end)

local minimized=false

connect(Minimize.MouseButton1Click,function()
    minimized=not minimized

    if minimized then
        Content.Visible=false
        Sidebar.Visible=false
        Main.Size=UDim2.fromOffset(620,68)
        Minimize.Text="+"
    else
        Content.Visible=true
        Sidebar.Visible=true
        Main.Size=UDim2.fromOffset(620,560)
        Minimize.Text="—"
    end
end)

connect(Close.MouseButton1Click,function()
    guiHidden=true
    Main.Visible=false
    FOVFrame.Visible=false
end)

connect(UIS.InputBegan,function(input)
    if input.UserInputType~=Enum.UserInputType.Keyboard then
        return
    end

    local key=input.KeyCode

    if key==Enum.KeyCode.Unknown then
        return
    end

    local name=key.Name

    if waitingCam then
        CONFIG.Camlock.Keybind=name
        waitingCam=false
        refresh()
        return
    end

    if waitingHide then
        CONFIG.GUI.HideKeybind=name
        waitingHide=false
        guiHidden=false
        Main.Visible=true
        refresh()
        return
    end

    if waitingWhitelist then
        CONFIG.Whitelist.Keybind=name
        waitingWhitelist=false
        refresh()
        return
    end

    if waitingNoclip then
        CONFIG.Games.NoclipKeybind=name
        waitingNoclip=false
        refresh()
        return
    end

    if waitingCFrame then
        CONFIG.Games.CFrameKeybind=name
        waitingCFrame=false
        refresh()
        return
    end

    if name==CONFIG.GUI.HideKeybind then
        guiHidden=not guiHidden
        Main.Visible=not guiHidden
        FOVFrame.Visible=CONFIG.Camlock.FOVCheck
        return
    end

    if name==CONFIG.Games.NoclipKeybind then
        setNoclip(not CONFIG.Games.Noclip)
        if currentTab=="Games" and Main.Visible then
            refresh()
        end
        return
    end

    if name==CONFIG.Games.CFrameKeybind then
        CONFIG.Games.CFrameSpeedEnabled=not CONFIG.Games.CFrameSpeedEnabled
        if currentTab=="Games" and Main.Visible then
            refresh()
        end
        return
    end

    if name==CONFIG.Whitelist.Keybind then
        local plr=playerUnderCursor()

        if plr then
            local id=tostring(plr.UserId)

            if CONFIG.Whitelist.Users[id] then
                CONFIG.Whitelist.Users[id]=nil
            else
                CONFIG.Whitelist.Users[id]=true
            end

            updateHighlight(plr)

            if currentTab=="Whitelist" and Main.Visible then
                refresh()
            end
        end

        return
    end

    if name==CONFIG.Camlock.Keybind then
        if CONFIG.Camlock.FOVBased then
            return
        end

        CONFIG.Camlock.Enabled=not CONFIG.Camlock.Enabled

        if CONFIG.Camlock.Enabled then
            target=closest()
        else
            target=nil
        end

        if currentTab=="Combat" and Main.Visible then
            refresh()
        end
    end
end)

local fovTimer=0
local targetSearchTimer=0

connect(RS.RenderStepped,function(dt)
    updateFOV()
    targetSearchTimer+=dt
    if CONFIG.Games.CFrameSpeedEnabled and CONFIG.Games.CFrameSpeed>0 then
        local character=LP.Character
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        local root=character and character:FindFirstChild("HumanoidRootPart")
        if humanoid and root and humanoid.Health>0 then
            local direction=humanoid.MoveDirection
            if direction.Magnitude>0 then
                root.CFrame=root.CFrame+direction*(CONFIG.Games.CFrameSpeed*dt*60)
            end
        end
    end

    gameFeatureTimer+=dt
    if gameFeatureTimer>=1 then
        gameFeatureTimer=0
        if CONFIG.Games.ArsenalHitbox then
            setArsenalHitbox(true)
        end
    end

    if CONFIG.Camlock.FOVBased then
        if target then
            local character=target.Character
            local part=character and aimPart(character)

            if not target.Parent or not character or not alive(character) or (CONFIG.Checks.KOCheck and ko(character)) or not isEnemy(target) or not part then
                target=nil
            else
                local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                if not onScreen or pos.Z<=0 or (Vector2.new(pos.X,pos.Y)-mousePosition()).Magnitude>CONFIG.Camlock.FOV then
                    target=nil
                end
            end
        end

        if not target and targetSearchTimer>=0.05 then
            targetSearchTimer=0
            target=closest()
        end

        CONFIG.Camlock.Enabled=target~=nil

        if not target then
            return
        end
    elseif not CONFIG.Camlock.Enabled then
        return
    end

    if target then
        if not target.Parent then
            target=nil
        else
            local character=target.Character

            if not character then
                target=nil
            elseif not alive(character) then
                target=nil
            elseif CONFIG.Checks.KOCheck and ko(character) then
                target=nil
            end
        end
    end

    if not target then
        if targetSearchTimer<0.05 then
            return
        end

        targetSearchTimer=0
        target=closest()

        if not target then
            return
        end
    end

    if not target.Parent then
        target=nil
        return
    end

    if not isEnemy(target) then
        return
    end

    local character=target.Character

    if not character or not alive(character) then
        target=nil
        return
    end

    if CONFIG.Checks.KOCheck and ko(character) then
        target=nil
        return
    end

    local part=aimPart(character)

    if not part then
        return
    end

    if CONFIG.Checks.WallCheck or CONFIG.Checks.VisibleCheck then
        if not visible(part,character) then
            return
        end
    end

    if CONFIG.Camlock.FOVCheck then
        local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

        if not onScreen or pos.Z<=0 then
            return
        end

        local d=(Vector2.new(pos.X,pos.Y)-mousePosition()).Magnitude

        if d>CONFIG.Camlock.FOV then
            return
        end
    end

    local desired=CFrame.lookAt(Camera.CFrame.Position,part.Position)

    local smoothing=math.clamp(tonumber(CONFIG.Camlock.Smoothing) or 0.15,0,1)
    local alpha=smoothing>=1 and 1 or 1-math.pow(1-smoothing,math.max(dt,0)*60)
    Camera.CFrame=Camera.CFrame:Lerp(desired,alpha)
end)

local function setupPlayer(plr)
    if plr==LP then
        return
    end

    playerConnections[plr]={}

    local list=playerConnections[plr]

    table.insert(list,plr.CharacterAdded:Connect(function()
        task.wait(.2)

        if CONFIG.Games.ArsenalHitbox then
            setArsenalHitbox(true)
        end

        if CONFIG.Visuals.HighlightAll then
            updateHighlight(plr)
        end

        if target==plr and CONFIG.Camlock.Enabled then
            target=nil
        end
    end))

    table.insert(list,plr:GetPropertyChangedSignal("Team"):Connect(function()
        if CONFIG.Visuals.HighlightAll then
            updateHighlight(plr)
        end

        if target==plr and CONFIG.Checks.TeamCheck and LP.Team and plr.Team==LP.Team then
            target=nil
        end
    end))

    if CONFIG.Visuals.HighlightAll and plr.Character then
        updateHighlight(plr)
    end
end

connect(LP.CharacterAdded,function(character)
    task.wait(0.2)
    if not isSpectating then
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        Camera=workspace.CurrentCamera
        if Camera and humanoid then
            Camera.CameraType=Enum.CameraType.Custom
            Camera.CameraSubject=humanoid
        end
    end
end)

for _,plr in ipairs(Players:GetPlayers()) do
    setupPlayer(plr)
end

connect(Players.PlayerAdded,function(plr)
    setupPlayer(plr)
end)

connect(Players.PlayerRemoving,function(plr)
    if selectedSpectateTarget==plr then
        unspectatePlayer()
    end

    removeHighlight(plr)

    local list=playerConnections[plr]

    if list then
        for _,c in ipairs(list) do
            pcall(function()
                c:Disconnect()
            end)
        end
    end

    playerConnections[plr]=nil

    if target==plr then
        target=nil
    end
end)

