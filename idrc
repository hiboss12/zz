local function setNoclip(enabled)
    CONFIG.Games.Noclip=enabled

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection=nil
    end

    local character=LP.Character

    if not enabled then
        for part,oldValue in pairs(originalCollisions) do
            pcall(function()
                part.CanCollide=oldValue
            end)
            originalCollisions[part]=nil
        end
        return
    end

    noclipConnection=RS.Stepped:Connect(function()
        local char=LP.Character
        if not char then
            return
        end

        for _,part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollisions[part]==nil then
                    originalCollisions[part]=part.CanCollide
                end
                part.CanCollide=false
            end
        end
    end)
end

local function setArsenalHitbox(enabled)
    CONFIG.Games.ArsenalHitbox=enabled

    if not enabled then
        for part,old in pairs(originalHitboxProperties) do
            pcall(function()
                part.Size=old.Size
                part.Transparency=old.Transparency
                part.CanCollide=old.CanCollide
            end)
            originalHitboxProperties[part]=nil
        end
        return
    end

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and plr.Character then
            for _,partName in ipairs({"RightUpperLeg","LeftUpperLeg","HeadHB","HumanoidRootPart"}) do
                local part=plr.Character:FindFirstChild(partName)
                if part and part:IsA("BasePart") then
                    if not originalHitboxProperties[part] then
                        originalHitboxProperties[part]={Size=part.Size,Transparency=part.Transparency,CanCollide=part.CanCollide}
                    end
                    part.CanCollide=false
                    part.Transparency=1
                    part.Size=Vector3.new(13,13,13)
                end
            end
        end
    end
end

local function removeHighlight(plr)
    local h=Highlights[plr]

    if h then
        pcall(function()
            h:Destroy()
        end)

        Highlights[plr]=nil
    end
end

local function shouldHighlight(plr)
    if not CONFIG.Visuals.HighlightAll then
        return false
    end

    if not plr or plr==LP then
        return false
    end

    if CONFIG.Visuals.TeamCheck and LP.Team and plr.Team==LP.Team then
        return false
    end

    return plr.Character~=nil
end

local function updateHighlight(plr)
    if not shouldHighlight(plr) then
        removeHighlight(plr)
        return
    end

    local character=plr.Character

    if not character then
        removeHighlight(plr)
        return
    end

    local h=Highlights[plr]

    if not h or h.Adornee~=character then
        removeHighlight(plr)

        h=Instance.new("Highlight")
        h.Name="ZZZHighlight"
        h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency=.85
        h.OutlineTransparency=0
        h.Parent=workspace

        Highlights[plr]=h
    end

    h.Adornee=character

    if isWhitelisted(plr) then
        h.FillColor=COLORS.White
        h.OutlineColor=COLORS.White
    else
        h.FillColor=COLORS.Enemy
        h.OutlineColor=COLORS.Enemy
    end
end

local function updateAllHighlights()
    if not CONFIG.Visuals.HighlightAll then
        for plr in pairs(Highlights) do
            removeHighlight(plr)
        end
        return
    end

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            updateHighlight(plr)
        end
    end
end

local function clearHighlights()
    for plr,h in pairs(Highlights) do
        pcall(function()
            h:Destroy()
        end)

        Highlights[plr]=nil
    end
end

