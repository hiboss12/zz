local OUTFIT_ONE_HEAD={215718515,1125510,74891470,1029025,7214246280,5891039736}
local OUTFIT_ONE_TORSO={5084106953,15506874658}

local function restoreOutfitOneCharacter(character)
    if not character then return end
    local added=outfitOneAdded[character]
    if added then
        for _,item in ipairs(added) do
            pcall(function() item:Destroy() end)
        end
        outfitOneAdded[character]=nil
    end
    local state=outfitOneStates[character]
    if not state then return end
    for _,item in ipairs(character:GetChildren()) do
        if item:IsA("Accessory") then
            pcall(function() item:Destroy() end)
        end
    end
    for _,accessory in ipairs(state.accessories) do
        pcall(function()
            accessory.Parent=character
        end)
    end
    for object,values in pairs(state.transparency) do
        if object and object.Parent then
            pcall(function()
                object.Transparency=values.Transparency
                if values.LocalTransparencyModifier~=nil then
                    object.LocalTransparencyModifier=values.LocalTransparencyModifier
                end
            end)
        end
    end
    outfitOneStates[character]=nil
end

local function outfitOneFindAttachment(rootPart,name)
    for _,object in ipairs(rootPart:GetDescendants()) do
        if object:IsA("Attachment") and object.Name==name then
            return object
        end
    end
end

local function outfitOneAddAccessory(assetId,parentPart,character)
    local ok,objects=pcall(function()
        return game:GetObjects("rbxassetid://"..tostring(assetId))
    end)
    if not ok or not objects or not objects[1] then return end
    local accessory=objects[1]
    local handle=accessory:FindFirstChild("Handle",true)
    if not handle or not handle:IsA("BasePart") then
        accessory:Destroy()
        return
    end
    accessory.Parent=character
    handle.Anchored=false
    handle.CanCollide=false
    handle.Massless=true
    local attachment=handle:FindFirstChildWhichIsA("Attachment")
    if attachment then
        local parentAttachment=outfitOneFindAttachment(parentPart,attachment.Name)
        if parentAttachment then
            local weld=Instance.new("Weld")
            weld.Part0=parentPart
            weld.Part1=handle
            weld.C0=parentAttachment.CFrame
            weld.C1=attachment.CFrame
            weld.Parent=handle
        else
            local weld=Instance.new("Weld")
            weld.Part0=parentPart
            weld.Part1=handle
            weld.C0=CFrame.new(0,0.5,0)
            weld.C1=CFrame.new()
            weld.Parent=handle
        end
    else
        local weld=Instance.new("Weld")
        weld.Part0=parentPart
        weld.Part1=handle
        weld.C0=CFrame.new(0,0.5,0)
        weld.C1=CFrame.new()
        weld.Parent=handle
    end
    outfitOneAdded[character]=outfitOneAdded[character] or {}
    table.insert(outfitOneAdded[character],accessory)
end

local function applyOutfitOneCharacter(character)
    if not outfitOneEnabled or not character or not character.Parent then return end
    if outfitOneStates[character] then return end
    local state={accessories={},transparency={}}
    outfitOneStates[character]=state
    for _,item in ipairs(character:GetChildren()) do
        if item:IsA("Accessory") then
            local ok,copy=pcall(function() return item:Clone() end)
            if ok and copy then table.insert(state.accessories,copy) end
        end
    end
    for _,object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            state.transparency[object]={Transparency=object.Transparency,LocalTransparencyModifier=object.LocalTransparencyModifier}
        elseif object:IsA("Decal") or object:IsA("Texture") then
            state.transparency[object]={Transparency=object.Transparency}
        end
    end
    for _,item in ipairs(character:GetChildren()) do
        if item:IsA("Accessory") then item:Destroy() end
    end
    local head=character:FindFirstChild("Head") or character:WaitForChild("Head",10)
    local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if head then
        head.Transparency=1
        head.LocalTransparencyModifier=1
        for _,object in ipairs(head:GetDescendants()) do
            if object:IsA("Decal") or object:IsA("Texture") then
                object.Transparency=1
            elseif object:IsA("BasePart") then
                object.Transparency=1
                object.LocalTransparencyModifier=1
            end
        end
        for _,assetId in ipairs(OUTFIT_ONE_HEAD) do outfitOneAddAccessory(assetId,head,character) end
    end
    if torso then
        for _,assetId in ipairs(OUTFIT_ONE_TORSO) do outfitOneAddAccessory(assetId,torso,character) end
    end
end

local function setOutfitOne(enabled)
    outfitOneEnabled=enabled
    if enabled then
        if LP.Character then task.spawn(applyOutfitOneCharacter,LP.Character) end
        if not outfitOneCharacterConnection then
            outfitOneCharacterConnection=LP.CharacterAdded:Connect(function(character)
                task.wait(0.5)
                if outfitOneEnabled then task.spawn(applyOutfitOneCharacter,character) end
            end)
        end
    else
        if outfitOneCharacterConnection then
            outfitOneCharacterConnection:Disconnect()
            outfitOneCharacterConnection=nil
        end
        for character in pairs(outfitOneStates) do
            restoreOutfitOneCharacter(character)
        end
    end
end

