            refreshConfigList()
        end)

        button("Refresh Configs",function()
            refresh()
        end)

        button("Unload Config",function()
            unloadConfig()
            refresh()
        end)

        toggle("Autoload Config",CONFIG.Config.Autoload,function(v)
            CONFIG.Config.Autoload=v
        end)

        section("Saved Configs")
        refreshConfigList()

        section("GUI")

        button("Hide GUI Keybind: "..CONFIG.GUI.HideKeybind,function(b)
            waitingHide=true
            b.Text="Press a key..."
        end)

        button("Unload Everything",function()
            target=nil
            CONFIG.Camlock.Enabled=false
            unspectatePlayer()
            setOutfitOne(false)
            setNoclip(false)
            setArsenalHitbox(false)
            setMM2Script(false)
            clearHighlights()
            disconnectAll()
            FOVGui:Destroy()
            GUI:Destroy()
        end)
    end
end

