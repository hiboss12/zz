        },
        Games={
            ArsenalHitbox=false,
            Noclip=false,
            NoclipKeybind="N",
            CFrameSpeedEnabled=false,
            CFrameSpeed=0.5,
            CFrameKeybind="Z",
            MM2Script=false
        },
        Whitelist={
            Enabled=false,
            Keybind="P",
            Users={}
        },
        Visuals={
            HighlightAll=false,
            TeamCheck=true
        },
        GUI={
