function refresh()
    clearContent()

    if currentTab=="Combat" then
        section("Camlock")

        toggle("Camlock",CONFIG.Camlock.Enabled,function(v)
            CONFIG.Camlock.Enabled=v

            if not v then
                target=nil
            else
                target=closest()
            end
        end)

        button("Keybind: "..CONFIG.Camlock.Keybind,function(b)
            waitingCam=true
            b.Text="Press a key..."
        end)

        dropdown("Aim Part",CONFIG.Camlock.AimPart,AIM_PARTS,function(v)
            CONFIG.Camlock.AimPart=v
        end)

        slider("Smoothing",CONFIG.Camlock.Smoothing,0,1,function(v)
            CONFIG.Camlock.Smoothing=v
        end)

        slider("FOV",CONFIG.Camlock.FOV,25,500,function(v)
            CONFIG.Camlock.FOV=v
        end)

        toggle("FOV Check",CONFIG.Camlock.FOVCheck,function(v)
            CONFIG.Camlock.FOVCheck=v
        end)

        toggle("FOV Based",CONFIG.Camlock.FOVBased,function(v)
            CONFIG.Camlock.FOVBased=v
            target=nil
            CONFIG.Camlock.Enabled=false
        end)

        button("Reset Target",function()
            target=nil
        end)

    elseif currentTab=="Checks" then
        section("Checks")

        toggle("Wall Check",CONFIG.Checks.WallCheck,function(v)
            CONFIG.Checks.WallCheck=v
        end)

        toggle("Visible Check",CONFIG.Checks.VisibleCheck,function(v)
            CONFIG.Checks.VisibleCheck=v
        end)

        toggle("KO Check",CONFIG.Checks.KOCheck,function(v)
            CONFIG.Checks.KOCheck=v
        end)

        toggle("Team Check",CONFIG.Checks.TeamCheck,function(v)
            CONFIG.Checks.TeamCheck=v
        end)

    elseif currentTab=="Visuals" then
        section("Visuals")

        toggle("Highlight All",CONFIG.Visuals.HighlightAll,function(v)
            CONFIG.Visuals.HighlightAll=v

            if v then
                updateAllHighlights()
            else
                clearHighlights()
            end
        end)

        toggle("Team Check",CONFIG.Visuals.TeamCheck,function(v)
            CONFIG.Visuals.TeamCheck=v
            updateAllHighlights()
        end)

    elseif currentTab=="Whitelist" then
        section("Whitelist")

        toggle("Whitelist Mode",CONFIG.Whitelist.Enabled,function(v)
            CONFIG.Whitelist.Enabled=v

            if CONFIG.Camlock.Enabled then
                target=nil
            end

            updateAllHighlights()
        end)

        button("Keybind: "..CONFIG.Whitelist.Keybind,function(b)
            waitingWhitelist=true
            b.Text="Press a key..."
        end)

        button("Clear Whitelist",function()
            table.clear(CONFIG.Whitelist.Users)
            updateAllHighlights()
            refresh()
        end)

        section("Whitelisted Players")

        local found=false

        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LP and isWhitelisted(plr) then
                found=true

                button(plr.Name,function()
                    CONFIG.Whitelist.Users[tostring(plr.UserId)]=nil
                    updateHighlight(plr)
                    refresh()
                end)
            end
        end

        if not found then
            local label=Instance.new("TextLabel")
            label.Size=UDim2.new(1,0,0,30)
            label.BackgroundTransparency=1
            label.Font=Enum.Font.Gotham
            label.Text="No whitelisted players"
            label.TextColor3=COLORS.Muted
            label.TextSize=13
            label.Parent=Content
        end

    elseif currentTab=="Settings" then
        section("Config")

        textbox("Config Name",CONFIG.Config.Name,function(v)
            CONFIG.Config.Name=v
        end)

        button("Save Config",function()
            saveConfig(CONFIG.Config.Name)
            refreshConfigList()
        end)

        button("Refresh Configs",function()
            refresh()
        end)

        button("Unload Config",function()
            unloadConfig()
            refresh()
        end)

        toggle("Autoload Config",CONFIG.Config.Autoload,function(v)
            CONFIG.Config.Autoload=v
        end)

        section("Saved Configs")
        refreshConfigList()

        section("GUI")

        button("Hide GUI Keybind: "..CONFIG.GUI.HideKeybind,function(b)
            waitingHide=true
            b.Text="Press a key..."
        end)

        button("Unload Everything",function()
            target=nil
            CONFIG.Camlock.Enabled=false
            clearHighlights()
            disconnectAll()
            FOVGui:Destroy()
            GUI:Destroy()
        end)
    end
end

