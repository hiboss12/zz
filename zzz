local function connect(signal,fn)
    local c=signal:Connect(fn)
    table.insert(connections,c)
    return c
end

local function disconnectAll()
    for _,c in ipairs(connections) do
        pcall(function()
            c:Disconnect()
        end)
    end

    table.clear(connections)

    for plr,list in pairs(playerConnections) do
        for _,c in ipairs(list) do
            pcall(function()
                c:Disconnect()
            end)
        end
    end

    table.clear(playerConnections)
end

local function clone(t)
    if type(t)~="table" then
        return t
    end

    local n={}

    for k,v in pairs(t) do
        n[k]=clone(v)
    end

    return n
end

local function merge(a,b)
    for k,v in pairs(a) do
        if type(v)=="table" and type(b[k])=="table" then
            merge(v,b[k])
        else
            b[k]=v
        end
    end
end

local function filesAvailable()
    return type(writefile)=="function"
        and type(readfile)=="function"
        and type(isfile)=="function"
        and type(makefolder)=="function"
        and type(isfolder)=="function"
        and type(listfiles)=="function"
        and type(delfile)=="function"
end

local folder="ZZZConfigs"

local function ensureFolder()
    if not filesAvailable() then
        return false
    end

    if not isfolder(folder) then
        pcall(function()
            makefolder(folder)
        end)
    end

    return isfolder(folder)
end

local function configPath(name)
    return folder.."/"..name..".json"
end

local function getConfigs()
    local result={}

    if not ensureFolder() then
        return result
    end

    local ok,files=pcall(listfiles,folder)

    if not ok or type(files)~="table" then
        return result
    end

    for _,path in ipairs(files) do
        local name=path:match("[^/\\]+$")

        if name then
            name=name:gsub("%.json$","")

            if name~="" then
                table.insert(result,name)
            end
        end
    end

    table.sort(result)

    return result
end

local function saveConfig(name)
    if not filesAvailable() then
        return false
    end

    name=tostring(name or ""):gsub("[^%w_%-%s]","")

    if name=="" then
        return false
    end

    ensureFolder()

    local data=clone(CONFIG)
    data.Config.Name=name

    local ok,result=pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if not ok then
        return false
    end

    local success=pcall(function()
        writefile(configPath(name),result)
    end)

    if success then
        selectedConfig=name
        CONFIG.Config.Name=name
    end

    return success
end

local function loadConfig(name)
    if not filesAvailable() or not name or name=="" then
        return false
    end

    local path=configPath(name)

    if not isfile(path) then
        return false
    end

    local ok,data=pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if not ok or type(data)~="table" then
        return false
    end

    local defaults={
        Camlock={
            Enabled=false,
            Keybind="C",
            Smoothing=.15,
            AimPart="Head",
            FOV=150,
            FOVCheck=true,
            FOVBased=false
        },
        Checks={
            WallCheck=false,
            KOCheck=true,
            VisibleCheck=false,
            TeamCheck=true
        },
        Whitelist={
            Enabled=false,
            Keybind="P",
            Users={}
        },
        Visuals={
            HighlightAll=false,
            TeamCheck=true
        },
        GUI={
            HideKeybind="RightShift"
        },
        Config={
            Name=name,
            Autoload=false
        }
    }

    merge(data,defaults)

    CONFIG=defaults
    CONFIG.Config.Name=name
    selectedConfig=name
    target=nil

    return true
end

local function deleteConfig(name)
    if not filesAvailable() or not name or name=="" then
        return false
