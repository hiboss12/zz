local function slider(name,value,min,max,callback)
    local holder=Instance.new("Frame")
    holder.Size=UDim2.new(1,0,0,55)
    holder.BackgroundTransparency=1
    holder.Parent=Content

    local label=Instance.new("TextLabel")
    label.BackgroundTransparency=1
    label.Size=UDim2.new(1,0,0,22)
    label.Font=Enum.Font.Gotham
    label.TextColor3=COLORS.Text
    label.TextSize=13
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.Text=name.."  "..tostring(value)
    label.Parent=holder

    local bar=Instance.new("Frame")
    bar.Position=UDim2.fromOffset(0,30)
    bar.Size=UDim2.new(1,0,0,6)
    bar.BackgroundColor3=COLORS.Input
    bar.BorderSizePixel=0
    bar.Parent=holder

    local corner=Instance.new("UICorner")
    corner.CornerRadius=UDim.new(1,0)
    corner.Parent=bar

    local fill=Instance.new("Frame")
    fill.Size=UDim2.new((value-min)/(max-min),0,1,0)
    fill.BackgroundColor3=COLORS.On
    fill.BorderSizePixel=0
    fill.Parent=bar

    local fillCorner=Instance.new("UICorner")
    fillCorner.CornerRadius=UDim.new(1,0)
    fillCorner.Parent=fill

    local dragging=false

    local function setFromX(x)
        local pct=math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local newValue=min+(max-min)*pct

        if max-min<=1 then
            newValue=math.floor(newValue*100)/100
        else
            newValue=math.floor(newValue+.5)
        end

        fill.Size=UDim2.new(pct,0,1,0)
        label.Text=name.."  "..tostring(newValue)
        callback(newValue)
    end

    connect(bar.InputBegan,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=true
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputChanged,function(input)
        if dragging and input.UserInputType==Enum.UserInputType.MouseMovement then
            setFromX(input.Position.X)
        end
    end)

    connect(UIS.InputEnded,function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            dragging=false
        end
    end)

    return holder
end

local function toggle(name,value,callback)
    local b=button(name..": "..(value and "ON" or "OFF"),function(btn)
        value=not value
        btn.Text=name..": "..(value and "ON" or "OFF")
        btn.BackgroundColor3=value and COLORS.On or COLORS.Button
        callback(value)
    end)

    b.BackgroundColor3=value and COLORS.On or COLORS.Button

    return b
end

local function removeHighlight(plr)
    local h=Highlights[plr]

    if h then
        pcall(function()
            h:Destroy()
        end)

        Highlights[plr]=nil
    end
end

local function shouldHighlight(plr)
    if not CONFIG.Visuals.HighlightAll then
        return false
    end

    if not plr or plr==LP then
        return false
    end

    if CONFIG.Visuals.TeamCheck and LP.Team and plr.Team==LP.Team then
        return false
    end

    return plr.Character~=nil
end

local function updateHighlight(plr)
    if not shouldHighlight(plr) then
        removeHighlight(plr)
        return
    end

    local character=plr.Character

    if not character then
        removeHighlight(plr)
        return
    end

    local h=Highlights[plr]

    if not h or h.Adornee~=character then
        removeHighlight(plr)

        h=Instance.new("Highlight")
        h.Name="ZZZHighlight"
        h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency=.85
        h.OutlineTransparency=0
        h.Parent=workspace

        Highlights[plr]=h
    end

    h.Adornee=character

    if isWhitelisted(plr) then
        h.FillColor=COLORS.White
        h.OutlineColor=COLORS.White
    else
        h.FillColor=COLORS.Enemy
        h.OutlineColor=COLORS.Enemy
    end
end

local function updateAllHighlights()
    if not CONFIG.Visuals.HighlightAll then
        for plr in pairs(Highlights) do
            removeHighlight(plr)
        end
        return
    end

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            updateHighlight(plr)
        end
    end
end

local function clearHighlights()
    for plr,h in pairs(Highlights) do
        pcall(function()
            h:Destroy()
        end)

        Highlights[plr]=nil
    end
end

