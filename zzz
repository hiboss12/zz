local function alive(character)
    if not character then
        return false
    end

    local hum=character:FindFirstChildOfClass("Humanoid")

    if not hum then
        return false
    end

    return hum.Health>0 and hum:GetState()~=Enum.HumanoidStateType.Dead
end

local function ko(character)
    if not character then
        return true
    end

    local hum=character:FindFirstChildOfClass("Humanoid")

    if not hum or hum.Health<=0 or hum:GetState()==Enum.HumanoidStateType.Dead then
        return true
    end

    for _,name in ipairs({"KO","K.O","Knocked","Downed"}) do
        local value=character:FindFirstChild(name)

        if value and value:IsA("BoolValue") and value.Value then
            return true
        end
    end

    return false
end

local function aimPart(character)
    if not character then
        return nil
    end

    local requested=CONFIG.Camlock.AimPart

    local names={
        Head={"Head"},
        Torso={"Torso","UpperTorso","HumanoidRootPart"},
        UpperTorso={"UpperTorso","Torso","HumanoidRootPart"},
        LowerTorso={"LowerTorso","HumanoidRootPart","Torso"},
        Root={"HumanoidRootPart","Torso","UpperTorso"}
    }

    for _,name in ipairs(names[requested] or names.Head) do
        local part=character:FindFirstChild(name)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function isWhitelisted(plr)
    return plr and CONFIG.Whitelist.Users[tostring(plr.UserId)]==true
end

local function isEnemy(plr)
    if not plr or plr==LP then
        return false
    end

    if CONFIG.Whitelist.Enabled and not isWhitelisted(plr) then
        return false
    end

    if CONFIG.Checks.TeamCheck and LP.Team and plr.Team==LP.Team then
        return false
    end

    return true
end

local function visible(part,character)
    if not part or not character then
        return false
    end

    local origin=Camera.CFrame.Position
    local direction=part.Position-origin

    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={LP.Character,character}
    params.IgnoreWater=true

    return workspace:Raycast(origin,direction,params)==nil
end

local function mousePosition()
    return UIS:GetMouseLocation()
end

local function closest()
    local mouse=mousePosition()
    local best=nil
    local bestDistance=math.huge

    for _,plr in ipairs(Players:GetPlayers()) do
        if isEnemy(plr) then
            local character=plr.Character

            if character and alive(character) and (not CONFIG.Checks.KOCheck or not ko(character)) then
                local part=aimPart(character)

                if part then
                    local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                    if onScreen and pos.Z>0 then
                        local distance=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude

                        if (not CONFIG.Camlock.FOVCheck or distance<=CONFIG.Camlock.FOV) and distance<bestDistance then
                            local allowed=true

                            if CONFIG.Checks.WallCheck or CONFIG.Checks.VisibleCheck then
                                allowed=visible(part,character)
                            end

                            if allowed then
                                best=plr
                                bestDistance=distance
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

local function playerUnderCursor()
    local mouse=mousePosition()
    local closestPlayer=nil
    local closestDistance=35

    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            local character=plr.Character
            local part=character and aimPart(character)

            if part then
                local pos,onScreen=Camera:WorldToViewportPoint(part.Position)

                if onScreen and pos.Z>0 then
                    local distance=(Vector2.new(pos.X,pos.Y)-mouse).Magnitude

                    if distance<closestDistance then
                        closestPlayer=plr
                        closestDistance=distance
                    end
                end
            end
        end
    end

    return closestPlayer
end

