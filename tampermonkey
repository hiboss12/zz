        const codes = [];
        for (let i = 0; i < s.length; i++) codes.push(s.charCodeAt(i));
        if (!codes.length) return "";
        let prev = d[codes[0]];
        const out = [prev];
        for (let k = 1; k < codes.length; k++) {
            const code = codes[k];
            let entry;
            if (code in d) entry = d[code];
            else if (code === dsize) entry = prev + prev[0];
            else throw new Error("bad LZW code");
            out.push(entry);
            d[dsize] = prev + entry[0];
            dsize++;
            prev = entry;
        }
        return out.join("");
    }
