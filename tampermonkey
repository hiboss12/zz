    function maybePatchRestUserModel(text) {
        let obj;
        try { obj = JSON.parse(text); } catch (_) { return null; }
        const ref = { changed: false };
        const isRowArr = (a) => Array.isArray(a) && a.length
            && a.some(r => r && typeof r === "object" && r.balance_type !== undefined);
        (function walk(o, key) {
            if (!o || typeof o !== "object") return;
            if (Array.isArray(o)) {
                if (key === "balances" && isRowArr(o)) {
                    o.splice(0, o.length, ...applySpoof(o));
                    ref.changed = true;
                    return;
                }
                for (const v of o) walk(v, null);
                return;
            }
            if (o.balance_type !== undefined) {
                patchRowObject(o, ref);
                if (isRowArr(o.balances)) {
                    patchUserModel(o);
                    ref.changed = true;
                }
                for (const [k, v] of Object.entries(o)) {
                    if (v && typeof v === "object") walk(v, k);
                }
                return;
            }
            if (isRowArr(o.balances)) {
                patchUserModel(o);
                ref.changed = true;
                return;
            }
            for (const [k, v] of Object.entries(o)) walk(v, k);
        })(obj, null);
        return ref.changed ? JSON.stringify(obj) : null;
    }

