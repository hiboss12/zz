    function baccaratPayout(betcode, amount, outcomes) {
        const bc = String(betcode);
        if (bc === "0") { if (outcomes.has("PLAYER")) return amount * 2; if (outcomes.has("TIE")) return amount; }
        else if (bc === "1") { if (outcomes.has("BANKER")) return amount * 1.95; if (outcomes.has("TIE")) return amount; }
        else if (bc === "2") { if (outcomes.has("TIE")) return amount * 9; }
        else if (bc === "3") { if (outcomes.has("PLAYER_PAIR")) return amount * 12; }
        else if (bc === "4") { if (outcomes.has("BANKER_PAIR")) return amount * 12; }
        else if (bc === "5") { if (outcomes.has("PERFECT_PAIR")) return amount * 26; }
        else if (bc === "6") { if (outcomes.has("PLAYER_PAIR") || outcomes.has("BANKER_PAIR")) return amount * 6; }
        else if (bc === "9") { if (outcomes.has("BIG")) return amount * 1.5; }
        else if (bc === "10") { if (outcomes.has("SMALL")) return amount * 2.5; }
        return 0.0;
    }

