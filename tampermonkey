    function installSlotBalanceBroadcaster() {
        if (PG_DOM_SYNC.broadcastTimer !== null) return;
        if (typeof W.addEventListener === "function") {
            W.addEventListener("message", (ev) => {
                try {
                    const d = ev && ev.data;
                    if (!d || typeof d !== "object" || d[SLOT_BRIDGE_KEY] !== true) return;
                    if (d.type !== "REQUEST_BALANCE") return;
                    if (!Store.enabled || !ENABLE_PATCHER) return;
                    const usd = Number(balUsd()) || 0;
                    if (usd <= 0) {
                        const hop = iVal(d.hop, 0);
                        if (hop < SLOT_BRIDGE_MAX_HOPS) {
                            pgBridgeFanOutToChildren({ [SLOT_BRIDGE_KEY]: true, type: "REQUEST_BALANCE", hop: hop + 1 });
                        }
                        return;
                    }
                    ev.source.postMessage({
                        [SLOT_BRIDGE_KEY]: true, type: "BALANCE_SYNC",
                        balanceUsd: usd, balanceText: slotBridgeBalanceText(usd), hop: 0,
                    }, "*");
                } catch (_) { }
            }, false);
        }
        broadcastSlotBalance();
        PG_DOM_SYNC.broadcastTimer = setInterval(broadcastSlotBalance, 1000);
    }

    const PG_FIELDS = {
        balance: ["BalanceDisplayed", "Balance", "BalanceCashValue", "BalanceValue"],
        bet: ["TotalBetValue", "TotalBet", "LineBetValue", "TotalBetInsteadOfSpinButton", "BetAmountValue"],
        win: ["WinValue", "TotalWin", "WinDisplayed", "WinAmountValue"],
    };

    const PG_DOM = {
        installed: false,
        roots: new Set(),
        rootsInstalled: false,
        locked: new Map(),
        observer: null,
        lastBetAt: 0, lastBetAmount: 0,
        awaitingWin: false, lastWin: null,
        netSeenSpin: false,
        ticks: 0,
    };

    function pgInstallShadowRegistry() {
        if (PG_DOM.rootsInstalled) return;
        if (typeof Element === "undefined" || !Element.prototype || !Element.prototype.attachShadow) return;
        PG_DOM.rootsInstalled = true;
        const origAttach = Element.prototype.attachShadow;
        Element.prototype.attachShadow = function (init) {
            const root = origAttach.call(this, init);
            try { if (root) PG_DOM.roots.add(root); } catch (_) { }
            return root;
        };
    }

    function pgRoots() {
        const out = [];
        for (const r of Array.from(PG_DOM.roots)) {
            try { if (r && r.host && r.host.isConnected !== false) out.push(r); else PG_DOM.roots.delete(r); }
            catch (_) { PG_DOM.roots.delete(r); }
        }
        return out;
    }

    function pgFindNodes(name) {
        const found = [];
        const push = (n) => { if (n && found.indexOf(n) < 0) found.push(n); };
        try { if (typeof document.getElementById === "function") push(document.getElementById(name)); } catch (_) { }
        try {
            if (typeof document.querySelectorAll === "function") {
                for (const n of Array.from(document.querySelectorAll("#" + CSS.escape(name)))) push(n);
            }
        } catch (_) { }
        for (const r of pgRoots()) {
            try { if (typeof r.getElementById === "function") push(r.getElementById(name)); } catch (_) { }
        }
        return found;
    }

    function pgFindField(kind) {
        for (const name of (PG_FIELDS[kind] || [])) {
            const nodes = pgFindNodes(name);
            if (nodes.length) return nodes;
        }
        return [];
    }

    function pgReadAmount(nodes) {
        for (const n of nodes) {
            const raw = String((n && (n.textContent || n.value)) || "").trim();
            if (!raw) continue;
            const cleaned = raw.replace(/[^\d.,-]/g, "").replace(/,/g, "");
            const v = parseFloat(cleaned);
            if (isFinite(v) && v >= 0) return v;
        }
        return null;
    }

    function pgLockBalance() {
        if (!Store.enabled || !ENABLE_PATCHER) { PG_DOM.locked.clear(); return; }
        const text = "$" + pgMoney(Math.round((Number(balUsd()) || 0) * 100));
        for (const node of pgFindField("balance")) {
            const prev = PG_DOM.locked.get(node);
            if (prev === text) continue;
            PG_DOM.locked.set(node, text);
            try {
                if (String(node.textContent) === text) continue;
                if (typeof node.textContent === "string" || node.childNodes) node.textContent = text;
            } catch (_) { }
        }
    }

    function pgInstallObserver() {
        if (PG_DOM.observer) return;
        const reassert = () => {
            for (const [node, text] of Array.from(PG_DOM.locked)) {
                try {
                    if (!node.isConnected && node.isConnected !== undefined) { PG_DOM.locked.delete(node); continue; }
                    if (String(node.textContent) !== text) node.textContent = text;
                } catch (_) { PG_DOM.locked.delete(node); }
            }
        };
        const Ctor = typeof MutationObserver === "function" ? MutationObserver : null;
        if (Ctor) {
            const mo = new Ctor(reassert);
            try { mo.observe(document, { childList: true, subtree: true, characterData: true }); } catch (_) { }
            PG_DOM.observer = { mo, watched: new WeakSet() };
        } else {
            PG_DOM.observer = { reassert, watched: new WeakSet() };
        }
        PG_DOM.reassert = reassert;
    }

    function pgWatchNewRoots() {
        const o = PG_DOM.observer;
        if (!o || !o.mo) return;
        for (const r of pgRoots()) {
            if (o.watched.has(r)) continue;
            try { o.mo.observe(r, { childList: true, subtree: true, characterData: true }); o.watched.add(r); } catch (_) { }
        }
    }

    function pgChargeWager(amount) {
        if (!(amount > 0)) return;
        if (PG_DOM.netSeenSpin) return;
        const now = Date.now();
        if (PG_DOM.lastBetAmount === amount && now - PG_DOM.lastBetAt < 2500) return;
        PG_DOM.lastBetAmount = amount; PG_DOM.lastBetAt = now;
        PG_DOM.lastWin = pgReadAmount(pgFindField("win"));
        PG_DOM.awaitingWin = true;
        try {
            adjBal(-amount);
            recordGame(GAME_SLOTS, amount, 0.0);
            pushBalanceAfterBet();
        } catch (e) { dbg("PG_DOM_BET_ERR", String(e)); }
    }

    function pgSyncWin() {
        if (!PG_DOM.awaitingWin) return;
        const win = pgReadAmount(pgFindField("win"));
        if (win === null) return;
        if (PG_DOM.lastWin !== null && Math.abs(win - PG_DOM.lastWin) < 1e-9) return;
        PG_DOM.awaitingWin = false;
        PG_DOM.lastWin = win;
        if (!(win > 0)) return;
        try {
            adjBal(win);
            recordGame(GAME_SLOTS, 0.0, win);
            pushBalanceAfterBet();
        } catch (e) { dbg("PG_DOM_WIN_ERR", String(e)); }
    }

    function pgInstallDisplayLayer() {
        if (PG_DOM.installed) return;
        if (!isPragmaticShellFrame() && !isSlotHost(hostname())) return;
        PG_DOM.installed = true;
        pgInstallShadowRegistry();
        pgInstallObserver();

        try {
            document.addEventListener("click", (ev) => {
                if (!Store.enabled || !ENABLE_PATCHER) return;
                if (PG_DOM.netSeenSpin) return;
                const amount = pgReadAmount(pgFindField("bet"));
                if (amount !== null) pgChargeWager(amount);
            }, true);
        } catch (e) { dbg("PG_DOM_CLICK_ERR", String(e)); }

        const tick = () => {
            try {
                if (!Store.enabled || !ENABLE_PATCHER) return;
                PG_DOM.ticks++;
                pgWatchNewRoots();
                if (PG_DOM.ticks % 2 === 0) pgLockBalance();
                if (!PG_DOM.netSeenSpin) pgSyncWin();
            } catch (e) { dbg("PG_DOM_TICK_ERR", String(e)); }
        };
        setInterval(tick, 500);
        if (typeof document.addEventListener === "function") {
            document.addEventListener("DOMContentLoaded", () => { try { pgLockBalance(); } catch (_) { } });
        }
        dbg("PG_DOM_LAYER", { host: hostname(), path: String(W.location && W.location.pathname || "") });
    }

    function pgNoteNetworkSpin() { PG_DOM.netSeenSpin = true; }

    function installPgDisplayLayer() { pgInstallDisplayLayer(); }

    function seedBalances() {
        const st = Store.read();
        let funded = 0;
        for (const v of Object.values(st.balances || {})) {
            if (fVal(v) > 0) funded++;
        }
        if (fVal(st.seed_v) >= SEED_VERSION && funded > 0) return;
        Store.update(s => {
            s.balances = Object.assign({}, SEED_BALANCES);
            s.balance = SEED_BALANCES["103"];
            s.active_coin = 103;
            s.spoof_coin = 103;
            s.seed_v = SEED_VERSION;
        });
        Ledger.replace(SEED_BALANCES);
        ACTIVE_COIN = 103;
        BalCache.cid = null;
        BalCache.v = null;
        BalCache.t = 0.0;
        dbg("SEEDED_BALANCES", { eth: 5, btc: 0.5 });
    }

    function loadPersistedMarket() {
        Ledger.load();
        const state = Store.read();
        const names = state.currency_names || {};
        for (const [k, v] of Object.entries(names)) {
            const cid = parseInt(k, 10);
            if (isFinite(cid)) CURRENCY_NAME[cid] = v;
        }
        const rates = state.crypto_rates || {};
        let n = 0;
        for (const [k, v] of Object.entries(rates)) {
            const cid = parseInt(k, 10), rate = parseFloat(v);
            if (isFinite(cid) && isFinite(rate) && rate > 0 && !PINNED_RATES.has(cid)) { CRYPTO_RATES_USD[cid] = rate; n++; }
        }
        const remembered = parseInt(state.active_coin, 10);
        if (isFinite(remembered) && remembered > 0) ACTIVE_COIN = remembered;
        const led = Ledger.snapshot();
        const missing = Object.keys(led).filter(k => state.balances[k] === undefined);
        if (missing.length) {
            Store.update(s => {
                s.balances = s.balances || {};
                for (const k of missing) {
                    const v = parseFloat(led[k]);
                    if (isFinite(v) && v >= 0) s.balances[k] = v;
                }
            });
        }
        const eth = CRYPTO_RATES_USD[103];
        dbg("MARKET_RESTORED", { names: Object.keys(names).length, rates: n, active: ACTIVE_COIN, ledger: Object.keys(led).length, eth_usd: eth ? Math.round(1 / eth) : null });
    }

    const PG_PROBE_SCHEDULE = [0, 60, 150, 350, 700, 1200, 2000, 3000, 4000, 4000, 4000, 4000, 4000, 4000, 4000, 4000];
    let pgProbeTimer = null;

    function installProviderExtras(host) {
        installWebSocketPatch();
        installFetchPatch();
        installXhrPatch();

        loadPersistedMarket();
        restoreWalletRows();

        if (host.includes("nolimit")) {
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", installNolimitBadgeCss);
            } else installNolimitBadgeCss();
        }

        startProviderLoop();
        installBalanceRelay();
        installPgDisplayLayer();
        installSlotDomBridge();
        dbg("BOOT_PROVIDER", { host });
    }

    function scheduleShellProbe() {
        if (pgProbeTimer !== null) return;
        let i = 0;
        const check = () => {
            pgProbeTimer = null;
            if (isPragmaticShellFrame()) {
                try { installProviderExtras(hostname()); } catch (e) { dbg("PG_PROBE_ERR", String(e)); }
                return;
            }
            if (i >= PG_PROBE_SCHEDULE.length) return;
            const delay = PG_PROBE_SCHEDULE[i++];
            pgProbeTimer = setTimeout(check, delay);
        };
        check();
    }

    function boot() {
        const host = hostname();
        const isDuelFrame = hostHas(host, DUEL_HOSTS);
        const isProvider = isSlotHost(host) || isPpLiveHost(host) || isPragmaticShellFrame();

        if (isDuelFrame) {
            installWebSocketPatch();
            installFetchPatch();
            installXhrPatch();

            loadPersistedMarket();
            seedBalances();
            restoreWalletRows();
            retireStaleDeposits();
            Capture.load();
            startBgLoop();
            installBalanceRelay();
            installSlotBalanceBroadcaster();
            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", () => DomLock.install(), { once: true });
            } else DomLock.install();
            setTimeout(() => { try { DomLock.syncHeader(); } catch (_) { } }, 300);
            setTimeout(() => { try { DomLock.syncHeader(); } catch (_) { } }, 1200);
            if (W === W.top || W.top === W) {
                Bridge.start();
                document.addEventListener("keydown", (ev) => {
                    if (!ev.ctrlKey || !ev.shiftKey || ev.altKey || ev.metaKey) return;
                    const k = String(ev.key).toLowerCase();
                    if (k !== "h" && k !== "l") return;
                    ev.preventDefault();
                    ev.stopPropagation();
                    Panel.toggle();
                }, true);
                try {
                    GM_registerMenuCommand("Toggle panel (Ctrl+Shift+H / Ctrl+Shift+L)", () => Panel.toggle());
                    GM_registerMenuCommand("Export state", exportState);
                    GM_registerMenuCommand("Import state (paste JSON)", () => {
                        const text = W.prompt("Paste live_casino_state.json content:");
                        if (text) importStateJson(text);
                    });
                    GM_registerMenuCommand("Import groomers templates (paste JSON)", () => {
                        const text = W.prompt("Paste groomers_templates.json content:");
                        if (text) importTemplatesJson(text);
                    });
                } catch (_) { }
            }
            dbg("BOOT_DUEL", { host });
        } else {
            installSlotDomBridge();
            if (isProvider) { installProviderExtras(host); return; }
            scheduleShellProbe();
            dbg("BOOT_UNCLASSIFIED", { host, path: String(W.location && W.location.pathname || "") });
        }
    }

    installPpLiveWsTap();
    installSlotWsTap();
    try {
        const install = () => {
            try {
                if (hostHas(W.location && W.location.hostname, PP_LIVE_HOSTS)) installPpLiveFrameBus();
            } catch (e) { dbg("PP_BUS_ERR", String(e)); }
        };
        if (hostHas(W.location && W.location.hostname, PP_LIVE_HOSTS)) install();
        else if (W.document && typeof W.document.addEventListener === "function") {
            W.document.addEventListener("DOMContentLoaded", install, { once: true });
        }
    } catch (e) { dbg("PP_BUS_ERR", String(e)); }

    try {
        boot();
    } catch (e) {
        dbg("BOOT_ERR", String(e));
    }
})();
