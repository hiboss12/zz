        if (ppFlag(gr, "banker_pair") || ppFlag(gr, "bankerPair")) out.add("BANKER_PAIR");
        if (ppFlag(gr, "perfectPair")) out.add("PERFECT_PAIR");
        if (ppFlag(gr, "bighand")) out.add("BIG");
