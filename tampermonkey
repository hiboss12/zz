    function bjSettle(st) {
        const dealer = st.dealer, shoe = st.shoe;
        while (bjHandValue(dealer) < 17) {
            dealer.push({ rank: shoe[0][0], suit: shoe[0][1], face_down: false });
            shoe.shift();
        }
        st.dealer = dealer;
        const pv = bjHandValue(st.player);
        const dv = bjHandValue(dealer);
        if (pv > 21) { st.is_win = false; st.is_push = false; st.payout_ratio = 0.0; st.player_result = "lose"; }
        else if (bjIsBlackjack(st.player) && !bjIsBlackjack(dealer)) { st.is_win = true; st.is_push = false; st.payout_ratio = 2.5; st.player_result = "blackjack"; }
        else if (dv > 21 || pv > dv) { st.is_win = true; st.is_push = false; st.payout_ratio = 2.0; st.player_result = "win"; }
        else if (pv === dv) { st.is_win = false; st.is_push = true; st.payout_ratio = 1.0; st.player_result = "push"; }
        else { st.is_win = false; st.is_push = false; st.payout_ratio = 0.0; st.player_result = "lose"; }
    }

    function bjPayoutUsd(st) {
        const staked = fVal(st.total_staked_usd !== undefined ? st.total_staked_usd : st.usdStake, 0);
        const payout = staked * fVal(st.payout_ratio, 0);
        if (!st._booked) {
            st._booked = true;
            recordGame(GAME_BLACKJACK, staked, payout - staked, st.coinId);
        }
        return payout;
    }

