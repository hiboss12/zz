            Object.assign(merged, spoofRow(cid, Store.balOf(cid), uid, r.balance_type_name, cid !== active));
            rows.push(merged);
        }
        for (const [k, v] of Object.entries(Store.balancesMap())) {
            const cid = parseInt(k, 10);
            if (!isFinite(cid) || seen.has(cid)) continue;
            const usd = fVal(v);
            if (usd <= 0) continue;
            rows.push(spoofRow(cid, usd, uid, null, cid !== active));
        }
        if (!rows.length) rows.push(spoofRow(active, Store.balOf(active), uid, null, false));
        return rows;
    }

    function restoreWalletRows() {
