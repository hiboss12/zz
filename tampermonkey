    const DEMO_BALANCE_BRIDGE = "__duelDemoBalanceSync";

    function balanceRelayMessage() {
        let usd = 0;
        try { usd = Number(balUsd()) || 0; } catch (_) { }
        return { [DEMO_BALANCE_BRIDGE]: true, at: Date.now(), balance: usd, coin: activeCoinId() };
    }

    function collectFrames(root, depth, acc) {
        if (!root || depth > 5) return acc;
        try {
            for (const frame of Array.from(root.querySelectorAll("iframe"))) {
                acc.push(frame);
                try { if (frame.contentDocument) collectFrames(frame.contentDocument, depth + 1, acc); } catch (_) { }
            }
        } catch (_) { }
        return acc;
    }

    function gameFrames() {
        return collectFrames(document, 0, []).filter((frame) => {
            let src = "";
            try { src = String(frame.getAttribute("src") || frame.src || ""); } catch (_) { }
            if (!src || src === "about:blank") return false;
            return !hostHas(safeHostname(src), ["duel.com"]);
        });
    }

    function safeHostname(url) {
        try { return new URL(url, W.location.href).hostname.toLowerCase(); } catch (_) { return ""; }
    }

    function broadcastBalanceToFrames() {
        if (W !== W.top) return 0;
        if (typeof document.querySelectorAll !== "function") return 0;
        const msg = balanceRelayMessage();
        const sent = new Set();
        let n = 0;
        for (const frame of gameFrames()) {
            const cw = frame && frame.contentWindow;
            if (!cw || sent.has(cw)) continue;
            sent.add(cw);
            try { cw.postMessage(msg, "*"); n++; } catch (_) { }
        }
        return n;
    }

    function isTrustedRelaySource(src) {
        if (!src) return false;
        if (W.parent === W) return false;
        let p = W.parent, depth = 0;
        while (p && depth++ < 32) {
            if (p === src) return true;
            if (p === p.parent) return false;
            try { p = p.parent; } catch (_) { return false; }
        }
        return false;
    }

    function installBalanceRelay() {
        if (W.__duel_relay_installed) return;
        if (typeof W.addEventListener !== "function") return;
        W.__duel_relay_installed = true;
        W.addEventListener("message", (ev) => {
            try {
                const d = ev && ev.data;
                if (!d || typeof d !== "object" || d[DEMO_BALANCE_BRIDGE] !== true) return;
                if (!isTrustedRelaySource(ev.source)) return;
                const usd = Number(d.balance);
                if (!isFinite(usd) || usd < 0) return;
                const cid = parseInt(d.coin, 10);
                if (isFinite(cid) && cid > 0 && cid !== activeCoinId()) selectCoin(cid);
                if (Math.abs(usd - balUsd()) < 1e-9) return;
                Store.setBalance(usd);
                lastDeliveredBal[0] = null;
                pushBalanceAfterBet();
                DomLock.push(activeCoinId(), usd);
                DomLock.syncHeader();
            } catch (e) { dbg("RELAY_ERR", String(e)); }
        }, false);
    }

    const SLOT_BRIDGE_KEY = "__duelSlotBalanceSync";
    const SLOT_BRIDGE_MAX_HOPS = 3;

    const PG_DOM_SYNC = {
        syncedUsd: null,
        syncedText: "",
        totalBet: 0,
        totalWin: 0,
        lastWin: null,
        awaitingWin: false,
        lockedText: "",
        bridgeInstalled: false,
        broadcastTimer: null,
        fastTimer: null,
    };

    function slotBridgeBalanceText(usd) {
        return "$" + pgMoney(Math.round((Number(usd) || 0) * 100));
    }

    function pgSetPersistentText(node, text) {
        try {
            if (!node) return;
            const only = node.childNodes && node.childNodes.length === 1 ? node.firstChild : null;
            if (only && only.nodeValue !== undefined && only.nodeValue !== null && only.nodeType === 3) {
                if (only.nodeValue !== text) only.nodeValue = text;
            } else if (String(node.textContent) !== text) {
                node.textContent = text;
            }
            if (typeof node.setAttribute === "function") node.setAttribute("data-charcount", String(text.length));
        } catch (_) { }
    }

    function pgBridgeDisplayed() {
        if (PG_DOM_SYNC.syncedUsd === null) return null;
        const v = PG_DOM_SYNC.syncedUsd - PG_DOM_SYNC.totalBet + PG_DOM_SYNC.totalWin;
        return v < 0 ? 0 : v;
    }

    function pgBridgeApply() {
        const usd = pgBridgeDisplayed();
        if (usd === null) return;
        const text = slotBridgeBalanceText(usd);
        if (text === PG_DOM_SYNC.lockedText) return;
        PG_DOM_SYNC.lockedText = text;
        for (const node of pgFindField("balance")) pgSetPersistentText(node, text);
    }

    function pgBridgeReassert() {
        const usd = pgBridgeDisplayed();
        if (usd === null) return;
        const text = slotBridgeBalanceText(usd);
        for (const node of pgFindField("balance")) {
            if (String(node.textContent) !== text) pgSetPersistentText(node, text);
        }
    }

    function pgBridgeTrackBet(amount) {
        if (!(amount > 0)) return;
        const now = Date.now();
        if (PG_DOM.lastBetAmount === amount && now - PG_DOM.lastBetAt < 2500) return;
        PG_DOM.lastBetAmount = amount; PG_DOM.lastBetAt = now;
        PG_DOM_SYNC.totalBet += amount;
        PG_DOM_SYNC.lastWin = pgReadAmount(pgFindField("win"));
        PG_DOM_SYNC.awaitingWin = true;
        pgBridgeApply();
    }

    function pgBridgeTrackWin() {
        if (!PG_DOM_SYNC.awaitingWin) return;
        const win = pgReadAmount(pgFindField("win"));
        if (win === null) return;
        if (PG_DOM_SYNC.lastWin !== null && Math.abs(win - PG_DOM_SYNC.lastWin) < 1e-9) return;
        PG_DOM_SYNC.awaitingWin = false;
        PG_DOM_SYNC.lastWin = win;
        if (win > 0) { PG_DOM_SYNC.totalWin += win; pgBridgeApply(); }
    }

    function pgBridgeRequestBalance() {
        for (const w of [W.parent, W.top, W.opener]) {
            if (!w || w === W) continue;
            try { w.postMessage({ [SLOT_BRIDGE_KEY]: true, type: "REQUEST_BALANCE" }, "*"); } catch (_) { }
        }
    }

    function installSlotDomBridge() {
        if (PG_DOM_SYNC.bridgeInstalled) return;
        if (isDuelHost(hostname())) return;
        if (typeof W.addEventListener !== "function") return;
        PG_DOM_SYNC.bridgeInstalled = true;

        W.addEventListener("message", (ev) => {
            try {
                const d = ev && ev.data;
                if (!d || typeof d !== "object" || d[SLOT_BRIDGE_KEY] !== true) return;
                if (d.type !== "BALANCE_SYNC") return;
                const usd = Number(d.balanceUsd);
                if (!isFinite(usd) || usd < 0) return;
                PG_DOM_SYNC.syncedUsd = usd;
                PG_DOM_SYNC.syncedText = String(d.balanceText || slotBridgeBalanceText(usd));
                PG_DOM_SYNC.totalBet = 0;
                PG_DOM_SYNC.totalWin = 0;
                PG_DOM_SYNC.lastWin = null;
                PG_DOM_SYNC.awaitingWin = false;
                pgBridgeApply();
                const hop = iVal(d.hop, 0);
                if (hop < SLOT_BRIDGE_MAX_HOPS) {
                    pgBridgeFanOutToChildren({
                        [SLOT_BRIDGE_KEY]: true, type: "BALANCE_SYNC",
                        balanceUsd: usd, balanceText: PG_DOM_SYNC.syncedText, hop: hop + 1,
                    });
                }
            } catch (e) { dbg("SLOT_BRIDGE_ERR", String(e)); }
        }, false);

        try {
            document.addEventListener("click", () => {
                if (!Store.enabled || !ENABLE_PATCHER) return;
                if (PG_DOM.netSeenSpin) return;
                const amount = pgReadAmount(pgFindField("bet"));
                if (amount !== null) pgBridgeTrackBet(amount);
            }, true);
        } catch (_) { }

        let askCount = 0, lastAsk = 0, lastProbe = 0;
        const stopFast = () => {
            if (PG_DOM_SYNC.fastTimer === null) return;
            try { clearInterval(PG_DOM_SYNC.fastTimer); } catch (_) { }
            PG_DOM_SYNC.fastTimer = null;
        };
        const startFast = () => {
            if (PG_DOM_SYNC.fastTimer !== null) return;
            PG_DOM_SYNC.fastTimer = setInterval(() => {
                try {
                    if (!Store.enabled || !ENABLE_PATCHER) { stopFast(); return; }
                    pgBridgeReassert();
                    if (!PG_DOM.netSeenSpin) pgBridgeTrackWin();
                } catch (e) { dbg("SLOT_BRIDGE_TICK_ERR", String(e)); }
            }, 400);
        };
        const probe = () => {
            try {
                if (!Store.enabled || !ENABLE_PATCHER) return;
                if (PG_DOM_SYNC.syncedUsd !== null) { startFast(); return; }
                const now = Date.now();
                if (now - lastProbe < 3000) return;
                lastProbe = now;
                if (!pgFindField("balance").length) return;
                if (askCount < 12 && now - lastAsk >= 1500) { lastAsk = now; askCount++; pgBridgeRequestBalance(); }
            } catch (e) { dbg("SLOT_BRIDGE_PROBE_ERR", String(e)); }
        };
        const onReady = () => probe();
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", onReady, { once: true });
        else probe();
        setInterval(probe, 1000);
        W.addEventListener("load", onReady, { once: true });

        dbg("SLOT_BRIDGE", { host: hostname(), path: String(W.location && W.location.pathname || "") });
    }

    function pgBridgeFanOutToChildren(payload) {
        let frames = [];
        try { frames = Array.from(document.querySelectorAll("iframe")); } catch (_) { return; }
        const sent = new Set();
        for (const f of frames) {
            let target = null;
            try { target = f.contentWindow; } catch (_) { continue; }
            if (!target || sent.has(target)) continue;
            try { target.postMessage(payload, "*"); sent.add(target); } catch (_) { }
        }
    }

    function broadcastSlotBalance() {
        if (!Store.enabled || !ENABLE_PATCHER) return;
        const usd = Number(balUsd()) || 0;
        pgBridgeFanOutToChildren({
            [SLOT_BRIDGE_KEY]: true,
            type: "BALANCE_SYNC",
