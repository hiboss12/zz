    async function tryBetPatchFetch(host, path, method, init, input) {
        if (!host.includes("duel.com")) return null;
        const base = path.split("?")[0];
        for (const [m, pat, fn] of BET_ROUTES) {
            if (m !== method) continue;
            const match = base.match(pat);
            if (!match) continue;
            if (Store.gamesBroken) {
                dbg("GAME_BROKEN", { path: base });
                return jsonResponse({ success: false, message: "An error occurred. Please try again." }, 503);
            }
            const ctx = { body: await readInitBody(init, input), path: base };
            try {
                const out = fn(ctx, match.slice(1));
                let status = 200, body;
                if (out && out.__status !== undefined) { status = out.__status; body = out.body; }
                else if (out && out.status !== undefined && out.body !== undefined) { status = out.status; body = out.body; }
                else body = out;
                dbg("PATCHED", { path: base, bal: Math.round(balUsd() * 1e4) / 1e4 });
                return jsonResponse(body, status);
            } catch (e) {
                dbg("PATCH_ERR", { path: base, err: String(e) });
                return jsonResponse({ success: false, message: "Temporarily unavailable, please retry." }, 200);
            }
        }
        if (method === "POST" && /\/api\/v2\//.test(base) && /bet|spin|start|reveal|cashout|draw|deal|double|hit|stand/.test(base)) {
            dbg("BET_UNMATCHED", { path: base });
        }
        return null;
    }

    const PROFILE_RE = /^\/api\/v2\/user\/profile\/[^/]+\/public$/;

    function maybePatchProfile(bodyObj) {
        const data = bodyObj && bodyObj.data;
        if (!data || typeof data !== "object") return null;
        const stats = Store.read().game_stats || {};
        const [depC, wdC] = fakeDepositTotalsCents();
        if (!Object.keys(stats).length && !depC && !wdC) return null;
        const gs = data.game_stats = data.game_stats || {};
        let addWagerC = 0;
        for (const [key, row] of Object.entries(stats)) {
            const wC = Math.round(fVal(row.wager) * 100);
            const pC = Math.round(fVal(row.profit) * 100);
            const tgt = gs[key] = gs[key] || { wager: 0, profit: 0, rakeback: 0 };
            tgt.wager = iVal(tgt.wager) + wC;
            tgt.profit = iVal(tgt.profit) + pC;
            addWagerC += wC;
        }
        data.total_bet = iVal(data.total_bet) + addWagerC;
        if (data.total_wagered !== undefined) data.total_wagered = iVal(data.total_wagered) + addWagerC;
        if (depC) data.deposits_total = iVal(data.deposits_total) + depC;
        if (wdC) data.withdrawals_total = iVal(data.withdrawals_total) + wdC;
        const dep = iVal(data.deposits_total);
        const wd = iVal(data.withdrawals_total);
        const target = wd + Math.round(Store.totalUsd() * 100) - dep;
        const keys = Object.keys(gs);
        let sum = 0;
        for (const k of keys) sum += iVal(gs[k] && gs[k].profit);
        const delta = target - sum;
        if (delta !== 0) {
            if (!keys.length) {
                gs.deposit_adjust = { wager: 0, profit: delta, rakeback: 0 };
            } else {
                const weights = keys.map(k => Math.max(0, iVal(gs[k] && gs[k].wager)));
                let total = weights.reduce((a, b) => a + b, 0);
                if (total <= 0) { total = keys.length; for (let i = 0; i < weights.length; i++) weights[i] = 1; }
                let allocated = 0;
                for (let i = 0; i < keys.length; i++) {
                    const r = gs[keys[i]];
                    if (!r) continue;
                    const share = (i === keys.length - 1) ? (delta - allocated) : Math.round(delta * weights[i] / total);
                    r.profit = iVal(r.profit) + share;
                    allocated += share;
                }
            }
        }
        data.total_profit = target;
        if (data.profit_loss !== undefined) data.profit_loss = target;
        if (data.total_pnl !== undefined) data.total_pnl = target;
        dbg("PROFILE_PATCHED", { wager_added: Math.round(addWagerC) / 100, pnl_set: Math.round(target) / 100, bal: Math.round(Store.totalUsd() * 100) / 100 });
        return bodyObj;
    }

    function txRow(tx) {
        const coin = parseInt(tx.coin, 10) || 105;
        const wagerUsd = fVal(tx.wager);
        const won = fVal(tx.won);
        const bBefore = fVal(tx.bal_before);
        const bMid = bBefore - wagerUsd;
        const bAfter = fVal(tx.bal_after, bMid);
        const ts = fVal(tx.ts, nowSecs());
        const date = new Date(ts * 1000).toLocaleString("sv-SE").replace("T", " ");
        const c = (usd) => Math.round(usd * 100);
        const row = {
            id: tx.id, secure_id: tx.secure_id,
            key: tx.key, type: tx.label || "Bet",
            balance: c(bBefore), balance_before_coins: bBefore.toFixed(6),
            delta: -c(wagerUsd), delta_coins: "-" + wagerUsd.toFixed(6),
            balance_after: c(bMid), balance_after_coins: bMid.toFixed(6),
            timestamp: Math.round(ts * 1000) / 1000, timestamp_raw: Math.floor(ts * 1000), date,
            invoice_id: null, user_id: USER.id || 0, note: null,
            related_transactions: [],
            currency: coin,
            amount_currency: "-" + fmtNative(Store.usdToNative(wagerUsd, coin)),
            balance_before_currency: fmtNative(Store.usdToNative(bBefore, coin)),
            balance_after_currency: fmtNative(Store.usdToNative(bMid, coin)),
        };
        if (tx._cash) {
            const delta = Math.round((won - wagerUsd) * 100);
            row.delta = delta;
            row.delta_coins = (won - wagerUsd).toFixed(6);
            row.amount_currency = fmtNative(Store.usdToNative(Math.abs(won - wagerUsd), coin));
            if (delta < 0) row.amount_currency = "-" + row.amount_currency;
            row.related_transactions = [];
            return row;
        }
        if (won > 0) {
            row.related_transactions.push({
                id: (tx.id || 0) + 1, secure_id: randSecureId(),
                key: tx.key, type: tx.label || "Bet",
                balance: c(bMid), balance_before_coins: bMid.toFixed(6),
                delta: c(won), delta_coins: won.toFixed(6),
                balance_after: c(bAfter), balance_after_coins: bAfter.toFixed(6),
                timestamp: Math.round((ts + 0.05) * 1000) / 1000, timestamp_raw: Math.floor(ts * 1000) + 50,
                date, invoice_id: null, user_id: USER.id || 0, note: null,
                currency: coin,
                amount_currency: fmtNative(Store.usdToNative(won, coin)),
                balance_before_currency: fmtNative(Store.usdToNative(bMid, coin)),
                balance_after_currency: fmtNative(Store.usdToNative(bAfter, coin)),
            });
        }
        return row;
    }

    function maybePatchTransactions(bodyObj, fullPath) {
        if (!bodyObj || !Array.isArray(bodyObj.data)) return null;
        let txs = (Store.read().fake_txs || []).slice();

        const qs = fullPath.includes("?") ? fullPath.split("?")[1] : "";
        const params = {};
        for (const part of qs.split("&")) {
            const eq = part.indexOf("=");
            if (eq > 0) params[part.slice(0, eq)] = part.slice(eq + 1);
        }
        const wanted = params.type;
        if (wanted) {
            try {
                const toks = decodeURIComponent(wanted).split(",").map(t => t.trim().toLowerCase()).filter(Boolean);
                if (toks.length) {
                    txs = txs.filter(t => {
                        const key = String(t.key || "").toLowerCase();
                        return toks.some(tok => key.includes(tok) || key.startsWith(tok.replace(/s$/, "")));
                    });
                }
            } catch (_) { }
        }

        const deps = Store.read().deposits || [];
        for (const d of deps) {
            if (!d.confirmed_notified) continue;
            const isWd = d.kind === "withdraw";
            const usd = fVal(d.usd);
            if (usd <= 0) continue;
            txs.push({
                key: isWd ? "withdrawal_invoices" : "deposit_invoices",
                label: isWd ? "Crypto Withdrawal" : "Crypto Deposit",
                coin: depCoinId(d) || activeCoinId(),
                wager: isWd ? usd : 0.0,
                won: isWd ? 0.0 : usd,
                bal_before: 0.0, bal_after: 0.0,
                ts: fVal(d.created, nowSecs()),
                id: d.row_id || randInt(1000000000, 2000000000),
                secure_id: randSecureId(),
                _cash: true,
            });
        }

        if (!txs.length) return null;
        txs.sort((a, b) => fVal(b.ts) - fVal(a.ts));
        let page = Math.max(1, iVal(params.page, 1));
        let per = Math.max(1, iVal(params.per_page, 15));
        const ours = txs.map(txRow);
        const merged = ours.concat(bodyObj.data);
        const start = (page - 1) * per;
        bodyObj.data = merged.slice(start, start + per);
        if (typeof bodyObj.total === "number") bodyObj.total = bodyObj.total + ours.length;
        dbg("TXS_PATCHED", { ours: ours.length, page, shown: bodyObj.data.length });
        return bodyObj;
    }

    function rakebackAvailable() {
        const st = Store.read();
        let wagered = 0.0;
        for (const row of Object.values(st.game_stats || {})) wagered += fVal(row.wager);
        const claimed = fVal((st.rewards_claimed || {})[RAKEBACK_KEY]);
        return Math.max(0.0, Math.round((wagered * RAKEBACK_RATE - claimed) * 1e4) / 1e4);
    }

