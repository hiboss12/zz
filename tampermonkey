    function makeWithdrawFrame(dep, confirmed) {
        const frame = makeDepositFrame(dep, confirmed);
        try {
            const parsed = parseSio(frame);
            if (parsed) {
                parsed.payload.type = "crypto_withdraw";
                return packSio(parsed.ns, parsed.event, parsed.payload);
