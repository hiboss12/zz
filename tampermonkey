    function patchBlackjackAction(ctx, roundId, action) {
        let st = ACTIVE_ROUNDS.get(roundId);
        if (!st || st.game !== "blackjack") {
            return { __status: 400, body: { success: false, message: "no active round" } };
        }
        const stakeUsd = st.usdStake;
        if (action === "hit") {
            st.acted = true;
            st.player.push({ rank: st.shoe[0][0], suit: st.shoe[0][1], face_down: false });
            st.shoe.shift();
            if (bjHandValue(st.player) >= 21) {
