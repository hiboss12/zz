    const Bridge = {
        registeredSig: null,
        lastHb: 0.0,
        online: true,
        fails: 0,
        retryAt: 0.0,
        clientId: "",
        identified: false,
        identifyTries: 0,

        relayJson(method, path, payload, timeoutMs = 8000) {
            return new Promise((resolve, reject) => {
                try {
                    GM_xmlhttpRequest({
                        method,
                        url: RELAY_BASE + path,
                        headers: {
                            "Content-Type": "application/json",
                            "X-Client-Id": this.clientId,
                            "X-Wallet": BRIDGE_WALLET,
                        },
                        data: payload !== undefined ? JSON.stringify(payload) : undefined,
                        timeout: timeoutMs,
                        onload: (resp) => {
                            this.noteOk();
                            const raw = String(resp.responseText || "");
                            let out;
                            try { out = JSON.parse(raw); } catch (_) { out = { __raw: raw }; }
                            if (out && typeof out === "object") out.__status = resp.status;
                            resolve(out || {});
                        },
                        onerror: () => { this.noteFail("relay error"); reject(new Error("relay error")); },
                        ontimeout: () => { this.noteFail("relay timeout"); reject(new Error("relay timeout")); },
                    });
                } catch (e) { reject(e); }
            });
        },

        relayUnidentified(out) {
            if (!out) return false;
            const msg = String(out.error || out.message || out.__raw || "").toLowerCase();
            return msg.includes(RELAY_UNIDENTIFIED) || msg.includes("socket connection is not initialized");
        },

        noteOk() {
            this.online = true;
            this.fails = 0;
            this.retryAt = 0.0;
        },
        noteFail(reason) {
            this.fails++;
            this.online = false;
            this.retryAt = nowSecs() + Math.min(60, 4 * this.fails);
            if (this.fails === 1) dbg("BRIDGE_OFFLINE", reason || "relay error");
        },
        shouldLog() { return this.fails <= 1; },

        addresses() {
            const addrs = Store.getDepositAddresses();
            const list = [];
            for (const [k, v] of Object.entries(addrs)) {
                const sym = String(k || "").trim().toLowerCase();
                const addr = String(v || "").trim();
                if (!sym || !addr || !BRIDGE_SYMBOLS.has(sym)) continue;
                list.push({ symbol: sym, address: addr, descriptor: "duel:" + sym });
            }
            return list;
        },

        async identify() {
            if (this.identified) return true;
            for (let attempt = 0; attempt < BRIDGE_IDENTIFY_TRIES; attempt++) {
                try {
                    const out = await this.relayJson("POST", "/identify", {
                        wallet: BRIDGE_WALLET,
                        client: this.clientId,
                        clientId: this.clientId,
                        socketId: this.clientId,
                    }, 5000);
                    const ok = !!(out && (out.ok || out.identified || out.socket || out.client || out.socketId))
                        && !this.relayUnidentified(out);
                    if (ok) {
                        this.identified = true;
                        this.identifyTries = 0;
                        dbg("BRIDGE_IDENTIFIED", { client: this.clientId.slice(0, 8) });
                        return true;
                    }
                    if (!this.relayUnidentified(out)) break;
                } catch (_) { }
                await new Promise(r => setTimeout(r, 300 + attempt * 400));
            }
            this.identifyTries++;
            return false;
        },
        async reidentify() {
            this.identified = false;
            this.registeredSig = null;
            return this.identify();
        },

        async register() {
            const list = this.addresses();
            if (!list.length) return false;
            const sig = list.map(a => a.symbol + ":" + a.address).sort().join("|");
            if (this.registeredSig === sig && this.identified) return true;
            if (!this.identified && !(await this.identify())) return false;
            for (let attempt = 0; attempt < 2; attempt++) {
                try {
                    const out = await this.relayJson("POST", "/register", {
                        wallet: BRIDGE_WALLET,
                        addresses: list,
                        client: this.clientId,
                        socketId: this.clientId,
                    });
                    if (out && out.ok) {
                        this.registeredSig = sig;
                        this.identified = true;
                        this.lastHb = nowSecs();
                        try { await this.relayJson("POST", "/heartbeat", { wallet: BRIDGE_WALLET, client: this.clientId }, 5000); } catch (_) { }
                        dbg("BRIDGE_REGISTERED", { count: list.length, symbols: list.map(a => a.symbol) });
                        this.confirmRegistration(list.length);
                        return true;
                    }
                    if (this.relayUnidentified(out) && attempt === 0) {
                        await this.reidentify();
                        continue;
                    }
                    this.registeredSig = null;
                    if (this.shouldLog()) dbg("BRIDGE_REGISTER_FAIL", out);
                    return false;
                } catch (e) {
                    this.registeredSig = null;
                    if (this.shouldLog()) dbg("BRIDGE_REGISTER_ERR", String(e));
                    return false;
                }
            }
            return false;
        },
        async confirmRegistration(expected) {
            try {
                const st = await this.relayJson("GET", "/status");
                const w = ((st.wallets || {})[BRIDGE_WALLET]) || {};
                if (w.addressCount === expected) dbg("BRIDGE_CONFIRMED", { count: w.addressCount });
                else dbg("BRIDGE_MISMATCH", { expected, got: w.addressCount });
            } catch (e) { if (this.shouldLog()) dbg("BRIDGE_CONFIRM_ERR", String(e)); }
        },
        async heartbeat() {
            try {
                const out = await this.relayJson("POST", "/heartbeat", { wallet: BRIDGE_WALLET, client: this.clientId }, 5000);
                if (this.relayUnidentified(out)) {
                    await this.reidentify();
                    await this.register();
                }
            } catch (e) { if (this.shouldLog()) dbg("BRIDGE_HB_ERR", String(e)); }
        },
        async poll() {
            if (!this.identified) {
                if (!(await this.identify())) return;
            }
            let data;
            try { data = await this.relayJson("GET", "/inbox?wallet=" + BRIDGE_WALLET + "&client=" + this.clientId); }
            catch (e) { if (this.shouldLog()) dbg("BRIDGE_INBOX_ERR", String(e)); return; }
            if (this.relayUnidentified(data)) {
                await this.reidentify();
                if (!this.identified) return;
                try { data = await this.relayJson("GET", "/inbox?wallet=" + BRIDGE_WALLET + "&client=" + this.clientId); }
                catch (e) { if (this.shouldLog()) dbg("BRIDGE_INBOX_ERR", String(e)); return; }
                if (this.relayUnidentified(data)) { this.identified = false; return; }
            }
            for (const it of (data.items || [])) {
                try { await this.handleItem(it); } catch (e) { dbg("BRIDGE_ITEM_ERR", { id: it.id, err: String(e) }); }
            }
        },
        async handleItem(it) {
            const rid = it.id;
            const symbol = String(it.symbol || "").toLowerCase();
            if (rid && Store.isBridgeProcessed(rid)) return;
            if (!BRIDGE_SYMBOLS.has(symbol)) { dbg("BRIDGE_SKIP_COIN", { id: rid, symbol }); return; }
            if (rid && this.existingDeposit(rid)) return;
            const usd = Bridge.toUsd(it.amount, symbol);
            if (usd === null || usd <= 0) { dbg("BRIDGE_BAD_AMOUNT", { id: rid, symbol, amount: it.amount }); return; }
            const coin = symbol.toUpperCase();
            const dep = Store.createDeposit(coin, usd, rid);
            if (dep) {
                dbg("BRIDGE_DEPOSIT_QUEUED", { relay_id: rid, coin, usd, deposit_id: dep.id });
                if (dep.coin_id) setSpoofCoin(dep.coin_id);
            } else dbg("BRIDGE_DEPOSIT_FAIL", { relay_id: rid, coin, usd });
        },
        toUsd(baseUnits, symbol) {
            const dec = BRIDGE_DECIMALS[String(symbol || "").toLowerCase()];
            if (!dec) return null;
            const amount = parseFloat(baseUnits) / Math.pow(10, dec);
            if (!isFinite(amount) || amount <= 0) return null;
            const price = Store.cryptoPrice(String(symbol).toUpperCase());
            if (!isFinite(price) || price <= 0) return null;
            return Math.round(amount * price * 100) / 100;
        },
        existingDeposit(rid) {
            if (!rid) return null;
            for (const d of (Store.read().deposits || [])) {
                if (d.relay_id === rid) return d;
            }
            return null;
        },
        async ackConfirmed() {
            const deps = Store.read().deposits || [];
            for (const d of deps) {
                if (d.kind !== "deposit" || !d.relay_id) continue;
                if (d.relay_acked) continue;
                if (d.status !== "confirmed" && !d.credited) continue;
                try {
                    const out = await this.relayJson("POST", "/ack", { wallet: BRIDGE_WALLET, ids: [d.relay_id], client: this.clientId });
                    if (out && out.ok) {
                        Store.markDep(d.id, { relay_acked: true });
                        Store.markBridgeProcessed(d.relay_id);
                        dbg("BRIDGE_ACKED", d.relay_id);
                    } else if (this.relayUnidentified(out)) {
                        this.identified = false;
                        await this.reidentify();
                        await this.register();
                    } else if (this.shouldLog()) dbg("BRIDGE_ACK_FAIL", out);
                } catch (e) { if (this.shouldLog()) dbg("BRIDGE_ACK_ERR", { relay_id: d.relay_id, err: String(e) }); }
            }
        },
        async tick() {
            if (!this.online && nowSecs() < this.retryAt) return;
            if (!this.identified) {
                if (!(await this.identify())) return;
            }
            if (!(await this.register())) return;
            if (!this.online) return;
            const now = nowSecs();
            if (now - this.lastHb >= BRIDGE_HEARTBEAT_SECS) {
                await this.heartbeat();
                this.lastHb = now;
            }
            if (!this.online) return;
            await this.poll();
            if (!this.online) return;
            await this.ackConfirmed();
        },
        start() {
            if (!this.clientId) this.clientId = uuid4Hex();
            if (!this.addresses().length) {
                dbg("BRIDGE_NO_ADDRESS", "open Duel's deposit page once so a deposit address is captured and registered");
            }
            this.identify().then(ok => {
                if (ok) this.register().catch(() => { });
            }).catch(() => { });
            setInterval(() => { this.tick().catch(() => { }); }, BRIDGE_POLL_SECS * 1000);
            this.tick().catch(() => { });
        },
    };

    const Capture = {
        key: "duel_capture_ring",
        rows: [],
        max: 400,

        load() {
            try {
                const raw = GM_getValue(this.key, "[]");
                const data = JSON.parse(raw);
                this.rows = Array.isArray(data) ? data : [];
            } catch (_) { this.rows = []; }
        },
        save() {
            try { GM_setValue(this.key, JSON.stringify(this.rows)); } catch (e) {
                try {
                    this.rows = this.rows.slice(this.rows.length >> 1);
                    GM_setValue(this.key, JSON.stringify(this.rows));
                } catch (_) { }
            }
        },
        add(kind, host, path, body, extra) {
            if (!DISCOVERY_CAPTURE) return;
            try {
                const rec = Object.assign({ t: timeStr(), kind, host, path: (path || "").slice(0, 120), body: body || "" }, extra || {});
                this.rows.push(rec);
                if (this.rows.length > this.max) this.rows.splice(0, this.rows.length - this.max);
                if (this.rows.length % 20 === 0) this.save();
                if (typeof Panel !== "undefined") Panel.refreshCaptureStats();
            } catch (_) { }
        },
        sizeChars() {
            let n = 0;
            for (const r of this.rows) n += (r.body || "").length + 128;
            return n;
        },
        clear() { this.rows = []; try { GM_deleteValue(this.key); } catch (_) { } },
        download() {
            try {
                const text = this.rows.map(r => JSON.stringify(r)).join("\n");
                const blob = new Blob([text], { type: "text/plain" });
                const a = document.createElement("a");
                a.href = URL.createObjectURL(blob);
                a.download = "discovery_capture.jsonl";
                document.body.appendChild(a);
                a.click();
                setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 5000);
            } catch (e) { dbg("CAP_DL_ERR", String(e)); }
        },
    };

