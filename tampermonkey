    const lastDeliveredBal = [null];
    const BAL_TRACE = [];
    let balDirtyUntil = 0.0;
    const BAL_DIRTY_SECS = 2.5;
    let reassertPending = false;
    const REASSERT_BURST = [0.10, 0.30, 0.50, 0.80];
    let lastPushAt = 0.0;
    let pushQueuedAt = 0.0;

    function markBalanceDirty(secs = BAL_DIRTY_SECS) {
        balDirtyUntil = Math.max(balDirtyUntil, nowSecs() + secs);
    }

    function deliverBalance(usd) {
        if (injectWsAll(makeBalanceFrame()) > 0) { lastDeliveredBal[0] = usd; return true; }
        lastDeliveredBal[0] = null;
        return false;
    }

    function pushBalanceAfterBet() {
        const usd = balUsd();
        const delivered = lastDeliveredBal[0];
        const sameValue = delivered !== null && Math.abs(delivered - usd) < 1e-9;
        if (!sameValue) {
            lastPushAt = nowSecs();
            pushQueuedAt = 0.0;
            return deliverBalance(usd);
        }
        const wait = (lastPushAt + BAL_PUSH_MIN_GAP_SECS) - nowSecs();
        if (wait <= 0) {
            lastPushAt = nowSecs();
            pushQueuedAt = 0.0;
            return deliverBalance(usd);
        }
        if (pushQueuedAt > nowSecs()) return false;
        pushQueuedAt = nowSecs() + wait;
        setTimeout(() => {
            pushQueuedAt = 0.0;
            lastPushAt = nowSecs();
            try { deliverBalance(balUsd()); } catch (_) { }
        }, Math.max(1, Math.ceil(wait * 1000)));
        return false;
    }

    function pushBalanceBurst() {
        pushBalanceAfterBet();
        markBalanceDirty(1.5);
        DomLock.push(activeCoinId(), balUsd());
        DomLock.syncHeader();
        for (const d of [120, 280, 600]) {
            setTimeout(() => { try { pushBalanceAfterBet(); } catch (_) { } }, d);
        }
    }

    function reconcileBalance() {
        if (!Store.enabled || !ENABLE_PATCHER) return;
        const usd = balUsd();
        const delivered = lastDeliveredBal[0];
        const socketFresh = delivered !== null && Math.abs(delivered - usd) < 1e-9;
        if (socketFresh && DomLock.headerShows(usd)) return;
        deliverBalance(usd);
        DomLock.syncHeader();
    }

    function scheduleBalanceReassert() {
        if (reassertPending) return;
        reassertPending = true;
        for (const delay of REASSERT_BURST) {
            setTimeout(() => { try { pushBalanceAfterBet(); } catch (_) { } }, delay * 1000);
        }
        setTimeout(() => { reassertPending = false; }, 1000);
    }

    function creditAfter(usd, secs, coinId = null) {
        let coin = (coinId === null || coinId === undefined) ? activeCoinId() : parseInt(coinId, 10);
        if (!isFinite(coin) || coin <= 0) coin = activeCoinId();
        const amount = fVal(usd);
        if (!(amount > 0)) { pushBalanceAfterBet(); return; }
        setTimeout(() => {
            try {
                adjBal(amount, coin);
                pushBalanceBurst();
            } catch (_) { }
        }, Math.max(0, fVal(secs)) * 1000);
    }
    function pushBalanceDelayed(secs) {
        setTimeout(() => { try { pushBalanceAfterBet(); } catch (_) { } }, secs * 1000);
