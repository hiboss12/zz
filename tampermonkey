    function patchWsFrame(text) {
        if (!Store.enabled || !ENABLE_PATCHER) return null;
        if (!text.includes('"balances"') && !text.includes('"balance"')) return null;
        const parsed = parseSio(text);
        if (!parsed) return null;
        const { event, ns, payload } = parsed;
        if (!payload || typeof payload !== "object") return null;
        if (Array.isArray(payload)) return null;

        let changed = false;

        const model = payload.model;
        if (model && typeof model === "object" && ("balances" in model || "balance" in model)) {
            patchUserModel(model);
            changed = true;
        }
        if ("balances" in payload) {
            payload.balances = applySpoof(payload.balances || []);
            payload.balance = bumpBalSeq();
            changed = true;
        } else if (!model) {
            payload.balances = spoofedBalanceRows();
            payload.balance = bumpBalSeq();
            changed = true;
        }
        if (changed) {
            try {
                const shown = payload.balances || (payload.model || {}).balances || [];
                const want = activeCoinId();
                for (const row of shown) {
                    if (parseInt(row.balance_type, 10) === want) {
                        DomLock.lastUsd = fVal(row.balance_coins);
                        DomLock.lastNative = fVal(row.balance);
                        DomLock.schedule();
                        break;
                    }
                }
            } catch (_) { }
            return packSio(ns, event, payload, parsed.rest, parsed.ack);
        }
        return null;
    }

