    function ppTrackOutgoingBets(data, raw) {
        let node = data;
        if (typeof node === "string") {
            try { node = JSON.parse(node); } catch (_) { node = null; }
        }
        if (!node || typeof node !== "object") return;
        const found = [];
        const visit = (n, depth) => {
            if (!n || typeof n !== "object" || depth > 8) return;
            if (Array.isArray(n)) { for (const i of n) visit(i, depth + 1); return; }
            const betcode = n.betCode !== undefined ? n.betCode : (n.betcode !== undefined ? n.betcode : n.code);
            const amount = n.amount !== undefined ? n.amount : (n.stake !== undefined ? n.stake : (n.value !== undefined ? n.value : n.betAmount));
            if (betcode != null && amount != null) {
                const codeNum = Number(betcode);
                let amt = Number(amount);
                if (isFinite(amt) && amt > 0) {
                    if (amt > 1000 && Number.isInteger(amt)) amt /= 100;
                    if (codeNum === 2 || (codeNum >= 4 && codeNum <= 153) || ppGatesMode() || PP._forceRoulette) {
                        found.push({ betCode: String(betcode), amount: amt, table: String(n.table || n.tableId || PP.roulette_table || "") });
                    }
                }
            }
            for (const key of Object.keys(n)) if (n[key] && typeof n[key] === "object") visit(n[key], depth + 1);
        };
        visit(node, 0);
        for (const bet of found) {
            const dup = PP.roulette_bets.some(b => String(b.betCode) === bet.betCode && Math.abs(Number(b.amount) - bet.amount) < 0.001);
            if (dup) continue;
            PP.roulette_bets.push({ betCode: bet.betCode, amount: bet.amount });
            PP._lastOutBetAt = Date.now();
            PP._lastOutBetCode = bet.betCode;
            if (bet.table) { PP.roulette_table = bet.table; if (ppIsGatesTable(bet.table)) PP.gates = true; }
            adjBal(-bet.amount);
            recordGame(GAME_ROULETTE, bet.amount, -bet.amount);
            pushBalanceAfterBet();
            dbg("PP_BET_OUT", bet);
        }
        if (found.length) ppPersistBets("outgoing");
    }

