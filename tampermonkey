            try { host = new URL(url).hostname.toLowerCase(); } catch (_) { }
            if (!isPpLiveHost(host)) return;
            sock.__duel_pp = true;
            const isGameSock = isLiveGameSocketUrl(url);
            sock.__duel_live_game = isGameSock;
            if (isGameSock) {
                PP.gameSockets.push(sock);
                sock.__duel_rawAdd("close", () => ppForgetSocket(sock));
            }
            sock.__duel_addRewriter((text) => {
                if (!Store.enabled || !ENABLE_PATCHER) return null;
                return ppLiveWs(text);
            });
            sock.__duel_addSendObserver((text) => {
                if (!Store.enabled || !ENABLE_PATCHER) return;
                try { ppTrackOutgoingBets(text); } catch (e) { dbg("PP_SEND_OBS_ERR", String(e)); }
            });
            sock.__duel_rawAdd("message", (ev) => {
                if (sock.__duel_injecting) return;
                try {
                    if (typeof ev.data !== "string" || !Store.enabled || !ENABLE_PATCHER) return;
                    if (!ppPendingWin) return;
                    if (!PP.gameSockets.some(s => WsHub.open(s))) return;
                    const win = ppPendingWin;
                    ppPendingWin = null;
                    setTimeout(() => {
                        try {
                            for (const s of PP.gameSockets.slice()) {
                                if (WsHub.open(s)) s.__duel_inject(win);
                            }
                        } catch (e) { dbg("PP_WIN_ERR", String(e)); }
                    }, 30);
                } catch (e) { dbg("PP_WS_ERR", String(e)); }
            });
        };
    }

