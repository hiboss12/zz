    function roulettePayout(betcode, amount, resultNum, winMul = 0, lucky = false) {
        const bc = String(betcode);
        const r = iVal(resultNum, -1);
        const straight = (lucky && winMul) ? amount * winMul : amount * 36;
        if (bc === "2") return r === 0 ? straight : 0.0;
        if (/^\d+$/.test(bc) && 4 <= parseInt(bc) && parseInt(bc) <= 39) return r === parseInt(bc) - 3 ? straight : 0.0;
        if (bc === "40") return (1 <= r && r <= 12) ? amount * 3 : 0.0;
        if (bc === "41") return (13 <= r && r <= 24) ? amount * 3 : 0.0;
        if (bc === "42") return (25 <= r && r <= 36) ? amount * 3 : 0.0;
        if (bc === "43") return (r > 0 && r % 3 === 1) ? amount * 3 : 0.0;
        if (bc === "44") return (r > 0 && r % 3 === 2) ? amount * 3 : 0.0;
        if (bc === "45") return (r > 0 && r % 3 === 0) ? amount * 3 : 0.0;
        if (bc === "46") return (1 <= r && r <= 18) ? amount * 2 : 0.0;
        if (bc === "47") return (r !== 0 && r % 2 === 0) ? amount * 2 : 0.0;
        if (bc === "48") return ROULETTE_RED.has(r) ? amount * 2 : 0.0;
        if (bc === "49") return ROULETTE_BLACK.has(r) ? amount * 2 : 0.0;
        if (bc === "50") return (r !== 0 && r % 2 === 1) ? amount * 2 : 0.0;
        if (bc === "51") return (19 <= r && r <= 36) ? amount * 2 : 0.0;
        if (/^\d+$/.test(bc) && 52 <= parseInt(bc) && parseInt(bc) <= 108) {
            const pair = splitPair(parseInt(bc) - 52);
            return (pair && r === pair[0] || pair && r === pair[1]) ? amount * 18 : 0.0;
        }
        if (/^\d+$/.test(bc) && 109 <= parseInt(bc) && parseInt(bc) <= 130) {
            const corner = cornerNums(parseInt(bc) - 109);
            return (corner && corner.includes(r)) ? amount * 9 : 0.0;
        }
        if (/^\d+$/.test(bc) && 131 <= parseInt(bc) && parseInt(bc) <= 142) {
            const ss = (parseInt(bc) - 131) * 3 + 1;
            return [ss, ss + 1, ss + 2].includes(r) ? amount * 12 : 0.0;
        }
        if (/^\d+$/.test(bc) && 143 <= parseInt(bc) && parseInt(bc) <= 153) {
            const ls = (parseInt(bc) - 143) * 3 + 1;
            return (r >= ls && r < ls + 6) ? amount * 6 : 0.0;
        }
        return 0.0;
    }

