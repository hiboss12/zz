            if (!cmd) return;
            const parts = cmd.replace(/^\//, "").split(/\s+/);
            const verb = (parts[0] || "").toLowerCase();
            if (verb === "depo" || verb === "deposit") {
                if (parts.length < 3) { this.status("Usage: /depo <crypto> <amount>   e.g. /depo btc 100", "#a06a00"); return; }
                const amount = parseFloat(parts[2]);
                if (!isFinite(amount) || amount <= 0) { this.status("Amount must be a positive number", "#a06a00"); return; }
                const crypto = String(parts[1]).toUpperCase().replace(/[^A-Z0-9]/g, "");
                if (!crypto) { this.status("Missing coin, e.g. /depo btc 100", "#a06a00"); return; }
                const dep = Store.createDeposit(crypto, amount);
                if (dep) {
                    if (dep.coin_id) setSpoofCoin(dep.coin_id);
                    this.status(`Deposit queued: ${dep.crypto_amount} ${dep.crypto} ($${dep.usd.toLocaleString("en-US", { minimumFractionDigits: 2 })}) - pending...`, "#1f7a3a");
                    document.getElementById("__duel_cmd").value = "";
                    try { processDeposits(); } catch (_) { }
