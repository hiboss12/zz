                ACTIVE_ROUNDS.delete(roundId);
                return bjResponseBody(roundId, st, true, true, true);
            }
            return bjResponseBody(roundId, st, false, false, true);
        }
        if (action === "stand") {
            bjSettle(st);
            creditAfter(bjPayoutUsd(st), BJ_REVEAL_SECS, st.coinId);
            ACTIVE_ROUNDS.delete(roundId);
            return bjResponseBody(roundId, st, true, true, true);
        }
        if (action === "double") {
            adjBal(-stakeUsd, st.coinId);
