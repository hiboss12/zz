    function vpNewDeck() {
        const deck = [];
        for (const r of VP_RANKS) for (const s of VP_SUITS) deck.push([r, s]);
        return shuffle(deck);
    }
    const vpCardStr = (c) => c[0] + c[1];
    function vpRankVal(r) {
        if (r === "A") return 14;
        if (r === "K") return 13;
        if (r === "Q") return 12;
        if (r === "J") return 11;
        const n = parseInt(r, 10);
        return isFinite(n) ? n : 0;
    }
    function vpEvaluate(cards) {
        const ranks = cards.map(c => vpRankVal(c[0])).sort((a, b) => a - b);
        const suits = cards.map(c => c[1]);
        const isFlush = new Set(suits).size === 1;
        const isStraight = (ranks[0] + 1 === ranks[1] && ranks[1] + 1 === ranks[2] && ranks[2] + 1 === ranks[3] && ranks[3] + 1 === ranks[4])
            || (ranks[0] === 2 && ranks[1] === 3 && ranks[2] === 4 && ranks[3] === 5 && ranks[4] === 14);
        const counts = {};
        for (const c of cards) counts[c[0]] = (counts[c[0]] || 0) + 1;
        const freq = Object.values(counts).sort((a, b) => b - a);
        let topPairRankVal = 0;
        for (const [r, cnt] of Object.entries(counts)) {
            if (cnt === 2 && vpRankVal(r) > topPairRankVal) topPairRankVal = vpRankVal(r);
        }
        if (isFlush && isStraight && ranks.includes(14) && ranks.includes(13)) return ["royal_flush", 250.0];
        if (isFlush && isStraight) return ["straight_flush", 50.0];
        if (freq[0] === 4) return ["four_of_a_kind", 25.0];
        if (freq[0] === 3 && freq[1] === 2) return ["full_house", 9.0];
        if (isFlush) return ["flush", 6.0];
        if (isStraight) return ["straight", 4.0];
        if (freq[0] === 3) return ["three_of_a_kind", 3.0];
        if (freq[0] === 2 && freq[1] === 2) return ["two_pair", 2.0];
        if (freq[0] === 2 && topPairRankVal >= 11) return ["jacks_or_better", 1.0];
        return ["none", 0.0];
    }

