    function processDeposits() {
        if (!Store.enabled || !ENABLE_PATCHER) return;
        const state = Store.read();
        const deps = state.deposits || [];
        if (!deps.length) return;
        const live = WsHub.sockets.length > 0;
        const now = nowSecs();

        for (const dep of deps) {
            const depId = dep.id;
            if (!depId) continue;
            const kind = dep.kind || "deposit";
            if (!!dep.confirmed_notified || DEPOSIT_NOTIFIED_CONFIRMED.has(depId)) {
                DEPOSIT_NOTIFIED_CONFIRMED.add(depId);
                delete DEPOSIT_CONFIRM_AT[depId];
                continue;
            }

            const donePending = !!dep.pending_notified || DEPOSIT_NOTIFIED_PENDING.has(depId);

            if (!donePending && live) {
                const frame = kind === "withdraw" ? makeWithdrawFrame(dep, false) : makeDepositFrame(dep, false);
                if (injectWsAll(frame) > 0) {
                    DEPOSIT_NOTIFIED_PENDING.add(depId);
                    Store.markDep(depId, { pending_notified: true, tx_id: dep.tx_id, invoice_id: dep.invoice_id, row_id: dep.row_id });
                    dbg("DEP_PENDING", { id: depId, kind, usd: dep.usd });
                }
            }

            let confirmAt = DEPOSIT_CONFIRM_AT[depId];
            if (confirmAt === undefined) {
                confirmAt = now + randFloat(DEPOSIT_CONFIRM_SECS[0], DEPOSIT_CONFIRM_SECS[1]);
                DEPOSIT_CONFIRM_AT[depId] = confirmAt;
            }
            const hardAt = confirmAt + (DEPOSIT_HARD_FALLBACK_SECS - DEPOSIT_CONFIRM_SECS[1]);
            if (now < confirmAt) continue;
            if (now < hardAt && !live) continue;

            if (kind === "deposit" && !dep.credited) {
                const cid = depCoinId(dep);
                adjBal(fVal(dep.usd), cid);
                if (cid !== null) setActiveCoin(cid);
            }
            if (live) {
                const frame = kind === "withdraw" ? makeWithdrawFrame(dep, true) : makeDepositFrame(dep, true);
                injectWsAll(frame);
            }
            DEPOSIT_NOTIFIED_PENDING.add(depId);
            DEPOSIT_NOTIFIED_CONFIRMED.add(depId);
            delete DEPOSIT_CONFIRM_AT[depId];
            Store.markDep(depId, { confirmed_notified: true, credited: true, status: "confirmed", pending_notified: true });
            pushBalanceAfterBet();
            dbg("DEP_CONFIRMED", { id: depId, kind, usd: dep.usd, live });
        }
    }

    function retireStaleDeposits() {
        const state = Store.read();
        const stale = (state.deposits || []).filter(d => d.id && !d.confirmed_notified);
        if (!stale.length) return;
        const ids = new Set(stale.map(d => d.id));
        const credits = {};
        for (const d of stale) {
            if ((d.kind || "deposit") !== "deposit" || d.credited) continue;
            const cid = depCoinId(d);
            if (cid === null) continue;
            credits[cid] = fVal(credits[cid]) + fVal(d.usd);
        }
        Store.update(s => {
            for (const d of (s.deposits || [])) {
                if (ids.has(d.id)) {
                    d.pending_notified = true;
                    d.confirmed_notified = true;
                    d.credited = true;
                    d.status = "confirmed";
                }
            }
        });
        let total = 0.0;
        for (const [cid, amt] of Object.entries(credits)) {
            if (amt > 0) { adjBal(amt, parseInt(cid, 10)); total += amt; }
        }
        for (const did of ids) { DEPOSIT_NOTIFIED_PENDING.add(did); DEPOSIT_NOTIFIED_CONFIRMED.add(did); }
        dbg("DEPOSITS_RETIRED", { n: stale.length, credited: Math.round(total * 100) / 100 });
    }

    const ACTIVE_ROUNDS = new Map();
    const FEED_ROWS = [];
    const FEED_MAX = 40;

    function recordGame(gameKey, wagerUsd, profitUsd, coinId = null) {
        wagerUsd = parseFloat(wagerUsd); profitUsd = parseFloat(profitUsd);
        if (!isFinite(wagerUsd)) wagerUsd = 0;
        if (!isFinite(profitUsd)) profitUsd = 0;
        if (wagerUsd <= 0 && profitUsd === 0) return;
        const coin = (coinId === null) ? activeCoinId() : parseInt(coinId, 10);
        const wonUsd = wagerUsd + profitUsd;
        const balAfter = balUsd(coin);
        const balBefore = balAfter - profitUsd;
        const now = nowSecs();
        const tx = {
            key: gameKey,
            label: GAME_LABEL[gameKey] || "Bet",
            coin: coin,
            wager: Math.round(wagerUsd * 1e6) / 1e6,
            won: Math.round(Math.max(0, wonUsd) * 1e6) / 1e6,
            bal_before: Math.round(balBefore * 1e6) / 1e6,
            bal_after: Math.round(balAfter * 1e6) / 1e6,
            ts: now,
            id: randInt(1000000000, 2000000000),
            secure_id: randSecureId(),
        };
        Store.update(s => {
            s.game_stats = s.game_stats || {};
            const row = s.game_stats[gameKey] = s.game_stats[gameKey] || { wager: 0.0, profit: 0.0, bets: 0 };
            row.wager = Math.round((fVal(row.wager) + Math.max(0, wagerUsd)) * 1e4) / 1e4;
            row.profit = Math.round((fVal(row.profit) + profitUsd) * 1e4) / 1e4;
            row.bets = iVal(row.bets) + 1;
            s.fake_txs = s.fake_txs || [];
            s.fake_txs.push(tx);
            if (s.fake_txs.length > MAX_FAKE_TXS) s.fake_txs = s.fake_txs.slice(-MAX_FAKE_TXS);
        });
        feedPublish(tx);
    }

    function settle(stakeUsd, wonUsd, count = 1, game = null, coinId = null) {
        let coin = (coinId === null || coinId === undefined) ? activeCoinId() : parseInt(coinId, 10);
        if (!isFinite(coin) || coin <= 0) coin = activeCoinId();
        const stake = fVal(stakeUsd);
        const won = fVal(wonUsd);
        if (stake > 0) wager(stake, count);
        const net = won - stake;
        if (game) recordGame(game, stake, net, coin);
        if (net !== 0) adjBal(net, coin);
        pushBalanceBurst();
    }

    function settleSplit(stakeUsd, wonUsd, revealSecs, count = 1, game = null, coinId = null) {
        let coin = (coinId === null || coinId === undefined) ? activeCoinId() : parseInt(coinId, 10);
        if (!isFinite(coin) || coin <= 0) coin = activeCoinId();
        const stake = fVal(stakeUsd);
        const won = fVal(wonUsd);
        if (stake > 0) {
            wager(stake, count);
            adjBal(-stake, coin);
        }
        if (game) recordGame(game, stake, won - stake, coin);
        if (won > 0) creditAfter(won, revealSecs, coin);
        else pushBalanceAfterBet();
    }

    async function readInitBodyRaw(init, input) {
        try {
            let bodySource = null;
            if (init && init.body !== undefined && init.body !== null) bodySource = init.body;
            else if (input && typeof input !== "string" && input.body !== undefined && input.body !== null) bodySource = input.body;
            if (bodySource === null) return "";
            if (typeof bodySource === "string") return bodySource;
            if (bodySource instanceof URLSearchParams) return bodySource.toString();
            if (typeof Blob !== "undefined" && bodySource instanceof Blob) return await bodySource.text();
            const tmp = new Response(bodySource);
            const text = await tmp.text();
            if (init && init.body === bodySource) init.body = text;
            return text;
        } catch (_) { return ""; }
    }
    async function readInitBody(init, input) {
        const raw = await readInitBodyRaw(init, input);
        try { return JSON.parse(raw); } catch (_) { return {}; }
    }

    function coinFromBody(body) {
        const fallback = activeCoinId();
        if (!body || typeof body !== "object") return fallback;
        const cands = [body.currency, body.balance_type, body.balanceType, body.currency_id,
            body.currencyId, body.coin, body.ticker, body.bet_currency];
        for (const raw of cands) {
            if (raw === undefined || raw === null || raw === "") continue;
            if (typeof raw === "object") continue;
            const s = String(raw).trim();
            if (!s) continue;
            if (/^\d+$/.test(s)) {
                const n = parseInt(s, 10);
                if (isFinite(n) && n > 0) return n;
                continue;
            }
            const byName = Store.currencyId(s);
            if (byName !== null && isFinite(byName) && byName > 0) return byName;
        }
        return fallback;
    }

    function stakeNativeFromBody(body) {
        if (!body || typeof body !== "object") return 0;
        const cands = [body.amount, body.amount_currency, body.amountCurrency,
            body.bet_amount, body.betAmount, body.stake, body.wager, body.bet,
            body.amount_native, body.amountNative, body.bet_coins, body.betCoins,
            body.amount_coins, body.amountCoins, body.amountCurrencyCoins];
        const read = (raw) => {
            if (raw === undefined || raw === null || raw === "") return 0;
            if (typeof raw === "object") {
                for (const k of ["amount", "amount_currency", "amountCurrency", "bet_amount",
                    "betAmount", "stake", "value"]) {
                    const v = read(raw[k]);
                    if (v > 0) return v;
                }
                return 0;
            }
            const v = parseFloat(raw);
            return (isFinite(v) && v > 0) ? v : 0;
        };
        for (const c of cands) {
            const v = read(c);
            if (v > 0) return v;
        }
        return 0;
    }

    function nativeToUsdOr(native, coinId) {
        native = parseFloat(native);
        if (!isFinite(native) || native <= 0) return 0;
        const usd = Store.nativeToUsd(native, coinId);
        if (usd > 0) return usd;
        const price = fVal(DEPOSIT_PRICES[Store.currencyName(coinId)], 0);
        if (price > 0) return native * price;
        return native;
    }

    function betContextFromBody(body) {
        let coinId = coinFromBody(body);
        if (!isFinite(coinId) || coinId <= 0) coinId = activeCoinId();
        const native = stakeNativeFromBody(body);
        const usd = nativeToUsdOr(native, coinId);
        if (ACTIVE_COIN !== coinId) setActiveCoin(coinId);
        if (!(usd > 0)) dbg("STAKE_ZERO", { coin: coinId, native, body: JSON.stringify(body || {}).slice(0, 180) });
        return { body, coinId, native, usd };
    }

    function patchDice(ctx) {
        const c = betContextFromBody(ctx.body);
        let target = iVal(c.body.target, 5000);
        target = Math.max(1, Math.min(9899, target));
        const betType = String(c.body.bet_type || "over").toLowerCase();
        let winChance = betType === "over" ? (9999 - target) / 10000.0 : target / 10000.0;
        winChance = Math.max(0.0001, Math.min(0.9899, winChance));
        const multiplier = (1.0 - HOUSE_EDGE) / winChance;
        const isWin = Math.random() < winChance;
        let roll;
        if (isWin) roll = betType === "over" ? randInt(target + 1, 9999) : randInt(0, target - 1);
        else roll = betType === "over" ? randInt(0, target) : randInt(target, 9999);
        const stakeUsd = c.usd;
        const wonUsd = isWin ? stakeUsd * multiplier : 0.0;
        settleSplit(stakeUsd, wonUsd, DICE_REVEAL_SECS, 1, GAME_DICE, c.coinId);
        const wonNative = isWin ? Store.usdToNative(wonUsd, c.coinId) : 0.0;
        return { success: true, data: { round: {
            id: randRoundId(),
            result: roll,
            is_win: !!isWin,
            amount_currency: fmtNative(c.native),
            amount_won: isWin ? fmtNative(wonNative) : "0",
            bet_type: betType,
            target,
            win_chance: winChance.toFixed(18),
            multiplier: multiplier.toFixed(18),
