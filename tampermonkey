    const ROULETTE_COIN_MULT = { one: 1, two: 2, three: 3, four: 4, five: 5, six: 6, seven: 7, eight: 8, ten: 10, twelve: 12, sixteen: 16, twenty: 20, fifty: 50 };
    const rouletteCoinMult = (coin) => fVal(ROULETTE_COIN_MULT[String(coin).toLowerCase()], 2);

    function roulettePlace(payload) {
        const coin = payload.coin;
        const coinId = coinFromBody(payload);
        if (ACTIVE_COIN !== coinId) setActiveCoin(coinId);
        const amountNative = stakeNativeFromBody(payload);
        const usd = nativeToUsdOr(amountNative, coinId);
        const rnd = payload.round;
        if (usd <= 0 || rnd === undefined || rnd === null || !coin) return;
        wager(usd); adjBal(-usd, coinId);
        const uid = USER.id || 0;
        const name = USER.username || "player";
        const avatar = USER.avatar || "";
        const betId = uuid4Hex().slice(0, 32);
        const p = { coin, coinId, amountNative, usd, amountCoinsUsd: usd, betId, round: rnd };
        (ROULETTE.bets[rnd] = ROULETTE.bets[rnd] || []).push(p);
        const cents = Math.round(usd * 100);
        const entry = {
            round: rnd, coin, amount: cents, currency: coinId, ts: payload.ts,
            id: betId, steam_name: name, name, avatar, lvl: 0, badges: [],
            amount_coins: payload.amount_coins || fmtCoins(usd),
            amount_currency: payload.amount || fmtNative(amountNative),
            balance_type: coinId, timestamp: null, user_id: uid, amount_won_currency: null,
            amount_won_coins: null, roulette_roll: null, effective_edge: 0, key: coin, uid,
        };
        injectWsAll(sioEventFrame("/roulette", ["own_bet", Object.assign({}, entry)]));
        pushBalanceAfterBet();
        dbg("ROULETTE_PLACE", { coin, usd: Math.round(usd * 1e4) / 1e4, round: rnd });
    }

    function rouletteOnEnd(payload) {
        if (!payload || typeof payload !== "object") return null;
        const rnd = payload.round;
        const winCoin = payload.coin;
        const pend = ROULETTE.bets[rnd] || [];
        delete ROULETTE.bets[rnd];
        if (!pend.length) return null;
        const uid = USER.id || 0;
        let wonUsd = 0.0, wonCoins = 0.0;
        const byCoin = {};
        for (const p of pend) {
            if (String(p.coin).toLowerCase() === String(winCoin).toLowerCase()) {
                const mult = rouletteCoinMult(p.coin);
                wonUsd += p.usd * mult;
                wonCoins += p.amountCoinsUsd * mult;
                byCoin[p.coinId] = fVal(byCoin[p.coinId]) + p.usd * mult;
            }
        }
        const stakedUsd = pend.reduce((a, x) => a + parseFloat(x.usd), 0);
        recordGame(GAME_ROULETTE, stakedUsd, wonUsd - stakedUsd, pend[0].coinId);
        if (wonUsd <= 0) return null;
        for (const [cid, amt] of Object.entries(byCoin)) {
            if (amt > 0) adjBal(amt, parseInt(cid, 10));
        }
        if (payload.winners && typeof payload.winners === "object" && !Array.isArray(payload.winners)) {
            payload.winners[String(uid)] = Math.round(wonCoins * 1e5) / 1e5;
        }
        pushBalanceAfterBet();
        dbg("ROULETTE_WIN", { coin: winCoin, won_usd: Math.round(wonUsd * 1e4) / 1e4 });
        return payload;
    }

    function handleGameWs(parsed, fromClient) {
        if (!Store.enabled || !ENABLE_PATCHER) return false;
        const ns = parsed.ns, event = parsed.event, payload = parsed.payload;
        if (ns === "/crash") {
            if (fromClient) {
                if (event === "place bet") { crashPlace(payload || {}); return true; }
                if (event === "cashout bet" || event === "cashout") { crashCashout(); return true; }
            } else if (event === "next") {
                crashOnNext(payload);
            }
            return false;
        }
        if (ns === "/roulette") {
            if (fromClient) {
                if (event === "place bet") { roulettePlace(payload || {}); return true; }
            } else if (event === "end") {
                const newp = rouletteOnEnd(payload);
                if (newp !== null) return { rewrite: sioEventFrame("/roulette", ["end", newp]) };
            }
            return false;
        }
        return false;
    }

